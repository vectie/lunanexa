# syntax=docker/dockerfile:1.7
# Required named context: --build-context moonleaf_source=/reviewed/moonleaf
FROM mirror.gcr.io/library/debian:bookworm-slim AS build-deps

ARG HTTPS_PROXY
ARG https_proxy
ARG HTTP_PROXY
ARG http_proxy
RUN apt-get -o Acquire::Retries=6 -o Acquire::Queue-Mode=host update \
    && apt-get -o Acquire::Retries=6 -o Acquire::Queue-Mode=host install -y --no-install-recommends \
      ca-certificates curl gcc git libc6-dev libpq-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.moon/bin:${PATH}"

FROM build-deps AS build
COPY _artifacts/moon-linux-amd64 /root/.moon
RUN chmod +x /root/.moon/bin/* /root/.moon/bin/internal/tcc \
    && ln -sfn moon /root/.moon/bin/moonx \
    && moon -C /root/.moon/lib/core bundle --warn-list -a --target native
COPY _artifacts/zig-linux-amd64 /root/zig
COPY images/zig-cc images/zig-ar /usr/local/bin/
RUN chmod +x /usr/local/bin/zig-cc /usr/local/bin/zig-ar
ENV MOON_CC=/usr/local/bin/zig-cc
ENV MOON_AR=/usr/local/bin/zig-ar

WORKDIR /src
COPY . .
# Copy source allowlists only: never a sibling repository's .git, caches or keys.
COPY --from=moonleaf_source moon.mod moon.pkg *.mbt README.mbt.md /moonleaf/
COPY --from=moonleaf_source docx/ /moonleaf/docx/
COPY --from=moonleaf_source opc/ /moonleaf/opc/
COPY --from=moonleaf_source pptx/ /moonleaf/pptx/
COPY --from=moonleaf_source render/ /moonleaf/render/
COPY --from=moonleaf_source scene/ /moonleaf/scene/
COPY --from=moonleaf_source xlsx/ /moonleaf/xlsx/
COPY --from=moonleaf_source xml/ /moonleaf/xml/
COPY images/control.moon.work /src/moon.work
RUN moon update && moon build cmd/control --target native --release --jobs 1

FROM lunanexa/runtime-base:bookworm-amd64

COPY --from=build /src/_build/native/release/build/vectie/lunanexa/cmd/control/control.exe /usr/local/bin/lunanexa-control
COPY --from=build /src/assets/contracts /usr/share/lunanexa/assets/contracts
COPY --from=build /src/assets/contracts/youthpolicy/v1/NVIDIA-DGX-Spark-remote-lease-revised.fillable.docx /usr/share/lunanexa/contracts/youthpolicy/NVIDIA-DGX-Spark-remote-lease-revised.fillable.docx
ENV LUNANEXA_CONTRACT_ASSETS_ROOT=/usr/share/lunanexa/assets/contracts
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/lunanexa-control"]
