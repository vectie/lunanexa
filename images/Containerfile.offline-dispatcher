# Build the three native executables for the image architecture first. No model
# weights or legal font binaries are included in this image.
ARG OFFLINE_BASE_IMAGE
FROM ${OFFLINE_BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates poppler-utils && rm -rf /var/lib/apt/lists/*
COPY offline-dispatcher /usr/local/bin/offline-dispatcher
COPY offline-artifact-worker /usr/local/bin/offline-artifact-worker
COPY offline-pdf-renderer /usr/local/bin/offline-pdf-renderer
# Supply a reviewed, architecture-matching, checksum-verified kubectl binary.
COPY kubectl /usr/local/bin/kubectl
ENV LUNANEXA_OFFLINE_ARTIFACT_WORKER_BIN=/usr/local/bin/offline-artifact-worker
ENV LUNANEXA_OFFLINE_RENDERER_BIN=/usr/local/bin/offline-pdf-renderer
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/offline-dispatcher"]
