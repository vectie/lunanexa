FROM mirror.gcr.io/library/debian:bookworm-slim AS build-deps

ARG HTTPS_PROXY
ARG https_proxy
ARG HTTP_PROXY
ARG http_proxy
RUN apt-get -o Acquire::Retries=6 -o Acquire::Queue-Mode=host update \
    && apt-get -o Acquire::Retries=6 -o Acquire::Queue-Mode=host install -y --no-install-recommends \
      ca-certificates curl gcc git libc6-dev libpq-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.moon/bin:${PATH}"

FROM build-deps AS build
COPY _artifacts/moon-linux-amd64 /root/.moon
RUN chmod +x /root/.moon/bin/* /root/.moon/bin/internal/tcc \
    && ln -sfn moon /root/.moon/bin/moonx \
    && moon -C /root/.moon/lib/core bundle --warn-list -a --target native
COPY _artifacts/zig-linux-amd64 /root/zig
COPY images/zig-cc images/zig-ar /usr/local/bin/
RUN chmod +x /usr/local/bin/zig-cc /usr/local/bin/zig-ar
ENV MOON_CC=/usr/local/bin/zig-cc
ENV MOON_AR=/usr/local/bin/zig-ar

WORKDIR /src
COPY . .
RUN moon build cmd/identity-gateway --target native --release --jobs 1

FROM lunanexa/runtime-base:bookworm-amd64

COPY --from=build /src/_build/native/release/build/cmd/identity-gateway/identity-gateway.exe /usr/local/bin/lunanexa-identity-gateway
USER 65532:65532
EXPOSE 8080 8081
ENTRYPOINT ["/usr/local/bin/lunanexa-identity-gateway"]
