----
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}
----

///|
async fn output(program : String, args : Array[String]) -> String {
  let result = @shell.Cmd(program, args).output()
  result.check()
  result.stdout()
}

///|
async fn directories(path : String) -> Array[String] {
  if !@fs.exists(path) {
    return []
  }
  output("find", [
    path, "-mindepth", "1", "-maxdepth", "1", "-type", "d", "-print",
  ])
  .split("\n")
  .filter(p => !p.is_empty())
  .map(p => p.to_owned())
  .to_array()
}

///|
fn archive_roots() -> Array[String] {
  [
    "/Users/kq/Documents/Codex/2026-10-17/task/push", "/Users/kq/Documents/Codex/2026-10-06/task/integration",
    "/Users/kq/Documents/Codex/2026-11-04/task/stage/moontown", "/Users/kq/mooncode-cost-20261106/fort/scratch",
    "/Users/kq/mooncode-live3-20261106/fort/scratch", "/Users/kq/mooncode-live-peers-20261107/fort/scratch",
    "/Users/kq/mooncode-live2-20261106/fort/scratch", "/Users/kq/Workspace/lunachip/scripts/_build",
  ]
}

///|
fn archive_build(path : String) -> Bool {
  archive_roots().any(root => path.has_prefix(root + "/")) &&
  !path.contains("/toolchains/") &&
  !path.contains("/.mooncakes/")
}

///|
fn archive_referenced(
  path : String,
  processes : String,
  opened : String,
) -> Bool {
  for root in archive_roots() {
    if path.has_prefix(root + "/") {
      return processes.contains(root) || opened.contains(root)
    }
  }
  true
}

///|
fn compiling(processes : String) -> Bool {
  // `moon run` remains alive while its compiled script serves requests.
  // Only exempt that wrapper once its direct runtime child exists. Actual
  // compiler processes anywhere in the snapshot still exclude cleanup.
  let rows = processes
    .split("\n")
    .filter(line => !line.trim().is_empty())
    .map(line => {
      line
      .split(" ")
      .filter(field => !field.is_empty())
      .map(field => field.to_owned())
      .to_array()
    })
    .to_array()
  let runtime_parents : Set[String] = Set([])
  for fields in rows {
    if fields.length() >= 4 &&
      (
        fields[2] == "moonrun" ||
        (
          fields[2].has_suffix(".exe") &&
          fields[3].has_suffix(".exe") &&
          (
            fields[3].contains("/native/debug/build/") ||
            fields[3].contains("/native/release/build/")
          )
        )
      ) {
      runtime_parents.insert(fields[1])
    }
  }
  rows.any(fields => {
    if fields.length() < 4 {
      return true
    }
    let name = fields[2]
    let text = fields[3:].join(" ")
    if name == "moon" &&
      (
        text.contains("clean-local-build-caches.mbtx") ||
        text.contains("prune-obsolete-moonfish-builds.mbtx") ||
        text.contains("maintain-local-builds.mbtx")
      ) {
      return false
    }
    if name == "moon" &&
      fields[3].split("/").last() == Some("moon") &&
      fields.get(4) == Some("run") &&
      runtime_parents.contains(fields[0]) {
      return false
    }
    let blocked = [
        "moon", "moonc", "clang", "clang++", "cc", "c++", "gcc", "g++", "ld", "ninja",
        "make", "gmake", "cargo", "rustc", "cmake", "xcodebuild", "vivado", "yosys",
        "nextpnr",
      ].contains(name) ||
      (
        name == "node" &&
        (
          text.contains("vite build") ||
          text.contains("webpack") ||
          text.contains("tsc")
        )
      )
    if blocked {
      println(
        "Build activity: PID=\{fields[0]} PPID=\{fields[1]} executable=\{name}",
      )
      if name == "moon" {
        println("Moon action: \{fields[3:fields.length().min(6)].join(" ")}")
      }
    }
    blocked
  })
}

///|
async fn main {
  if @env.args() is [_, "diagnose"] {
    let snapshot = output("ps", ["-ww", "-axo", "pid=,ppid=,ucomm=,args="])
    println("compiling=\{compiling(snapshot)}")
    for line in snapshot.split("\n") {
      let fields = line
        .split(" ")
        .filter(v => !v.is_empty())
        .map(v => v.to_owned())
        .to_array()
      if fields.length() > 0 && fields.length() < 4 {
        println("short process row: \{fields.join(" ")}")
      }
      if fields.length() >= 4 &&
        ["moon", "moonrun", "moonc", "clang", "ld", "make"].contains(fields[2]) {
        println(
          "PID=\{fields[0]} PPID=\{fields[1]} name=\{fields[2]} executable=\{fields[3]}",
        )
      }
    }
    return
  }
  if @env.args() is [_, "self-test"] {
    assert_true(
      archive_build(archive_roots()[0] + "/runners/check/script.mbtx"),
    )
    assert_true(!archive_build("/Users/kq/Workspace/lunanexa/_build"))
    assert_true(!archive_build(archive_roots()[0] + "-other/native"))
    assert_true(
      !archive_build(archive_roots()[0] + "/toolchains/moon/lib/core/_build"),
    )
    assert_true(
      compiling("10 1 moonc moonc /some/project\n11 1 clang clang -c test.c"),
    )
    assert_true(compiling("10 1 moon moon test --target native"))
    assert_true(
      !compiling(
        "10 1 moonclaw moonclaw daemon\n11 1 moondesk moondesk --port 4200\n12 1 moon moon run scripts/clean-local-build-caches.mbtx clean",
      ),
    )
    assert_true(
      !compiling(
        "20 1 moon moon run /tools/proxy.mbtx\n21 20 moonrun /bin/moonrun /tools/_build/proxy.wasm --",
      ),
    )
    assert_true(compiling("20 1 moon moon run /tools/proxy.mbtx"))
    assert_true(
      !compiling(
        "20 1 moon moon run cmd/neck_camera --target native\n21 20 neck_camera.exe /Users/kq/Workspace/moonrobo/_build/native/debug/build/vectie/moonrobo/cmd/neck_camera/neck_camera.exe",
      ),
    )
    assert_true(
      compiling(
        "20 1 moon moon run cmd/neck_camera --target native\n21 20 clang clang -c camera.c",
      ),
    )
    assert_true(
      !compiling(
        "20 1 moon /Users/kq/.moon/bin/moon run /tools/proxy.mbtx\n21 20 moonrun /bin/moonrun /tools/_build/proxy.wasm --",
      ),
    )
    assert_true(
      compiling(
        "20 1 moon moon run /tools/proxy.mbtx\n21 20 moonrun /bin/moonrun /tools/_build/proxy.wasm --\n22 1 clang clang -c active.c",
      ),
    )
    assert_true(
      compiling(
        "20 1 moon moon build\n21 20 moonrun /bin/moonrun unrelated.wasm",
      ),
    )
    assert_true(
      !archive_referenced(
        archive_roots()[0] + "/runners/old/native/debug/build",
        "moon build --target native /Users/kq/Workspace/moondesk",
        "n/Users/kq/Workspace/moondesk",
      ),
    )
    assert_true(
      archive_referenced(
        archive_roots()[0] + "/runners/old/native/debug/build",
        "moon build --target-dir " + archive_roots()[0] + "/runners/current",
        "",
      ),
    )
    assert_true(
      archive_referenced(
        archive_roots()[0] + "/runners/old/native/debug/build",
        "",
        "fcwd\nn" + archive_roots()[0],
      ),
    )
    assert_true(
      archive_referenced("/Users/kq/Workspace/moondesk/_build", "", ""),
    )
    println(
      "Compilation and isolated archive exclusion regression checks passed",
    )
    return
  }
  guard @env.args() is [_, phase] &&
    ["report", "clean", "clean-archives"].contains(phase) else {
    fail("report | clean | clean-archives")
  }
  let deleting = phase != "report"
  let isolated = phase == "clean-archives"
  let workspace = "/Users/kq/Workspace"
  let root = "/Users/kq/Library/Logs/MoonSuite/build-retention"
  if !@fs.exists(root) {
    @fs.mkdir(root, recursive=true, permission=0o700)
  }
  let stamp = output("date", ["-u", "+%Y%m%dT%H%M%SZ"]).trim().to_owned()
  let before = output("df", ["-k", "/System/Volumes/Data"])
  if phase == "clean" &&
    compiling(output("ps", ["-ww", "-axo", "pid=,ppid=,ucomm=,args="])) {
    println("Cache cleanup deferred: a compiler/build tool is running")
    return
  }
  let opened = @shell.Cmd("lsof", ["-nP", "-Fpn"]).output()
  guard opened.exit_code() == 0 else {
    fail("Could not inventory running file references")
  }
  let records : Array[Json] = []
  let mut removed_kib = 0L
  let repos = directories(workspace)
  // Archived integration/source checkouts keep generated test and JS caches
  // outside Workspace. Keep their primary native builds under the same rules.
  let development = "/Users/kq/moonsuite/development"
  if @fs.exists(development) {
    let git_paths = output("find", [
      development, "-maxdepth", "5", "-name", ".git", "-prune", "-print",
    ])
    for git_path in git_paths.split("\n") {
      let path = git_path.to_owned()
      if path.has_suffix("/.git") {
        let repo = path[:path.length() - 5].to_owned()
        if !repos.contains(repo) &&
          @fs.kind(repo, follow_symlink=false) is Directory {
          repos.push(repo)
        }
      }
    }
  }
  // Temporary compile/check copies were outside the old Workspace scan.
  // Only conventional generated target directories below Moon/Luna copies
  // are candidates; source, release bundles and experiment outputs stay put.
  for
    build in output("find", [
      "/private/tmp", "-maxdepth", "3", "-type", "d", "-name", "_build", "-print",
    ]).split("\n") {
    let parts = build.split("/").to_array()
    if parts.length() >= 5 &&
      (parts[3].has_prefix("moon") || parts[3].has_prefix("luna")) &&
      !parts[3].has_prefix("lunachip") {
      let repo = build[:build.length() - 7].to_owned()
      if !repos.contains(repo) {
        repos.push(repo)
      }
    }
  }
  repos.push("/Users/kq/moonsuite/tools")
  // Audited historical compile tasks use --target-dir, not always _build.
  // The compiler database identifies the target root; keep its metadata and
  // delete only generated backend targets, not the surrounding task archive.
  let custom_builds : Set[String] = Set([])
  for root in archive_roots() {
    let chip_scripts = root == "/Users/kq/Workspace/lunachip/scripts/_build"
    // The hardware workspace stays excluded from automatic clean. Only this
    // explicitly audited manual operation may prune obsolete script targets.
    if chip_scripts && phase == "clean" {
      continue
    }
    if !@fs.exists(root) {
      continue
    }
    for
      marker in output("find", [
        root, "-type", "f", "-name", ".moon_db", "-print",
      ]).split("\n") {
      if !marker.is_empty() {
        let path = marker[:marker.length() - 9].to_owned()
        if chip_scripts {
          let leaf = path.split("/").last().unwrap().to_owned()
          if !leaf.has_suffix(".mbtx") ||
            leaf == "phase6-store-assertion-partition.mbtx" ||
            !@fs.exists("/Users/kq/Workspace/lunachip/scripts/" + leaf) {
            continue
          }
        }
        if archive_build(path) &&
          @fs.kind(path, follow_symlink=false) is Directory {
          custom_builds.insert(path)
          if !repos.contains(path) {
            repos.push(path)
          }
        }
      }
    }
  }
  let nested_ui : Set[String] = Set([])
  for repo in repos.copy() {
    if repo.has_prefix("/private/tmp/") ||
      custom_builds.contains(repo) ||
      !@fs.exists(repo + "/.git") {
      continue
    }
    for suffix in ["/ui", "/src/ui"] {
      let root = repo + suffix
      if !@fs.exists(root) {
        continue
      }
      for
        build in output("find", [
          root, "-maxdepth", "4", "-type", "d", "-name", "_build", "-prune", "-print",
        ]).split("\n") {
        if !build.is_empty() && !build.contains("/.mooncakes/") {
          let parent = build[:build.length() - 7].to_owned()
          if @fs.exists(parent + "/moon.mod") {
            nested_ui.insert(parent)
            if !repos.contains(parent) {
              repos.push(parent)
            }
          }
        }
      }
    }
  }
  for repo in repos {
    let name = repo.split("/").to_array().last().unwrap().to_owned()
    let temporary = repo.has_prefix("/private/tmp/")
    let tools = repo == "/Users/kq/moonsuite/tools"
    let custom = custom_builds.contains(repo)
    if isolated && !custom {
      continue
    }
    let inherited_git = if custom {
      @shell.Cmd("git", ["-C", repo, "rev-parse", "--show-toplevel"])
      .output()
      .exit_code() ==
      0
    } else {
      false
    }
    let git_repo = @fs.exists(repo + "/.git") ||
      nested_ui.contains(repo) ||
      inherited_git
    if !temporary &&
      !tools &&
      !custom &&
      !nested_ui.contains(repo) &&
      (
        (!name.has_prefix("moon") && !name.has_prefix("luna")) ||
        name == "lunachip" ||
        !git_repo
      ) {
      continue
    }
    let candidates : Array[String] = []
    for path in directories(if custom { repo } else { repo + "/_build" }) {
      let leaf = path.split("/").to_array().last().unwrap().to_owned()
      if leaf == "native" {
        // Keep primary CLI/shared-library build outputs, including cold launches.
        for level in directories(path) {
          for
            kind in (if temporary || custom {
              ["test", "check", "build"]
            } else {
              ["test", "check"]
            }) {
            if @fs.exists(level + "/" + kind) {
              candidates.push(level + "/" + kind)
            }
          }
        }
        continue
      }
      if leaf.has_suffix(".mbtx") ||
        leaf == "js" ||
        leaf == "wasm" ||
        leaf == "wasm-gc" ||
        leaf == "browser-compiled" ||
        leaf.has_prefix("desktop-") ||
        leaf.has_prefix("hosted-preview-") ||
        leaf.has_prefix("native-qa-") ||
        leaf.has_prefix("ui-locale-") {
        candidates.push(path)
      }
    }
    for path in directories(repo + "/scripts/_build") {
      candidates.push(path)
    }
    // Diagnostic scripts can be compiled beside retained experiment evidence.
    // Require the matching source and remove only its generated .mbtx cache,
    // never the surrounding results or model files.
    if !temporary && !tools && !custom && !nested_ui.contains(repo) {
      for folder in ["output", "outputs", "benchmarks"] {
        let root = repo + "/" + folder
        if !@fs.exists(root) {
          continue
        }
        for
          build in output("find", [
            root, "-maxdepth", "5", "-type", "d", "-name", "_build", "-prune", "-print",
          ]).split("\n") {
          if build.is_empty() {
            continue
          }
          let parent = build[:build.length() - 7].to_owned()
          for path in directories(build.to_owned()) {
            let leaf = path.split("/").last().unwrap().to_owned()
            if leaf.has_suffix(".mbtx") && @fs.exists(parent + "/" + leaf) {
              candidates.push(path)
            }
          }
        }
      }
    }
    // Local deployment staging keeps additional generated browser bundles.
    // Preserve the staging receipts, sources and OCI evidence beside them.
    for stage in directories(repo + "/tmp") {
      for path in directories(stage) {
        let leaf = path.split("/").to_array().last().unwrap().to_owned()
        if leaf == "browser-dist" ||
          leaf.has_suffix("-browser-dist") ||
          leaf.has_prefix("browser-dist-") ||
          leaf.contains("-browser-dist-") {
          candidates.push(path)
        }
      }
    }
    for path in candidates {
      if !@fs.exists(path) {
        continue
      }
      let relative = path[repo.length() + 1:].to_owned()
      if git_repo {
        let tracked = @shell.Cmd("git", ["-C", repo, "ls-files", "--", relative]).output()
        guard tracked.exit_code() == 0 else {
          fail("Cannot check tracked build contents")
        }
        if !tracked.stdout().trim().is_empty() {
          records.push({ "path": path, "status": "kept-tracked" })
          continue
        }
      }
      let processes = output("ps", ["-axo", "args="])
      if isolated &&
        (
          !archive_build(path) ||
          archive_referenced(path, processes, opened.stdout())
        ) {
        records.push({ "path": path, "status": "kept-archive-referenced" })
        continue
      }
      if processes.contains(path) || opened.stdout().contains(path) {
        records.push({ "path": path, "status": "kept-running" })
        continue
      }
      let recent = output("find", [path, "-mmin", "-1440", "-print", "-quit"])
      if !recent.trim().is_empty() {
        records.push({ "path": path, "status": "kept-recent" })
        continue
      }
      let size = output("du", ["-sk", path])
        .split("\t")
        .next()
        .unwrap()
        .to_owned()
      let kib = @string.parse_int64(size.trim().to_owned())
      if deleting {
        if !isolated &&
          compiling(output("ps", ["-ww", "-axo", "pid=,ppid=,ucomm=,args="])) {
          println("Cache cleanup deferred: compilation started")
          break
        }
        let live = output("lsof", ["-nP", "-Fpn"])
        let current = output("ps", ["-ww", "-axo", "args="])
        if isolated && archive_referenced(path, current, live) {
          records.push({ "path": path, "status": "kept-archive-referenced" })
          continue
        }
        if live.contains(path) || current.contains(path) {
          records.push({ "path": path, "status": "kept-running" })
          continue
        }
        if isolated &&
          !output("find", [path, "-mmin", "-1440", "-print", "-quit"])
          .trim()
          .is_empty() {
          records.push({ "path": path, "status": "kept-recent" })
          continue
        }
        let pending = path + ".cleanup-" + stamp
        guard !@fs.exists(pending) else {
          fail("Cleanup staging path already exists")
        }
        @shell.Cmd("mv", ["--", path, pending]).run()
        @shell.Cmd("rm", ["-rf", "--", pending]).run()
        removed_kib += kib
      }
      records.push({
        "path": path,
        "allocated_kib": kib,
        "status": if deleting {
          "removed-rebuildable"
        } else {
          "candidate"
        },
      })
      @fs.write_file(
        root + "/" + stamp + "-" + phase + ".json",
        Json::object({
          "records": records,
          "removed_allocated_kib": removed_kib,
        }).stringify(),
        permission=0o600,
      )
    }
  }
  let after = output("df", ["-k", "/System/Volumes/Data"])
  @fs.write_file(
    root + "/" + stamp + "-" + phase + ".json",
    Json::object({
      "records": records,
      "removed_allocated_kib": removed_kib,
      "filesystem_before": before,
      "filesystem_after": after,
      "preserved": [
        "running files", "builds modified within 24 hours", "tracked files", "model directories",
        "experiment results", "installed packs", "active lunachip hardware work",
      ],
    }).stringify(),
    permission=0o600,
  )
  println("Inspected build directories: " + records.length().to_string())
  println("Removed allocated KiB: " + removed_kib.to_string())
  println("Manifest: " + root + "/" + stamp + "-" + phase + ".json")
  println(after)
}
