///|
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x/crypto",
}

///|
async fn main {
  guard @env.args() is [_, kubeconfig, ns] else {
    fail("usage: provision-offline-render-secret.mbtx KUBECONFIG NAMESPACE")
  }
  let name = "lunanexa-offline-render-evidence"
  let existing = @shell.Cmd("kubectl", [
    "--kubeconfig", kubeconfig, "-n", ns, "get", "secret", name, "--ignore-not-found",
    "-o", "name",
  ]).output()
  existing.check()
  if existing.stdout().trim() != "" {
    println("Existing render-evidence Secret retained; no rotation performed.")
    return
  }
  guard @env.rand(32) is Some(bytes) else { fail("secure entropy unavailable") }
  let manifest : Json = {
    "apiVersion": "v1",
    "kind": "Secret",
    "metadata": { "name": name, "namespace": ns },
    "type": "Opaque",
    "stringData": {
      "LUNANEXA_RENDER_EVIDENCE_SECRET": @crypto.bytes_to_hex_string(bytes),
    },
  }
  let created = @shell.Cmd(
    "kubectl",
    ["--kubeconfig", kubeconfig, "-n", ns, "create", "-f", "-"],
    stdin=Text(manifest.stringify()),
  ).output()
  if created.exit_code() != 0 {
    fail("render Secret creation failed; response intentionally withheld")
  }
  println(
    "Created render-evidence Secret; secret value was not printed or written to disk.",
  )
}
