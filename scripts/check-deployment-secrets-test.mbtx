import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
}

async fn main {
  let scratch = @fs.tmpdir(prefix="lunanexa-secret-scan-")
  defer @fs.rmdir(scratch, recursive=true)
  @fs.mkdir(scratch + "/deploy")
  @fs.mkdir(scratch + "/tests")
  @fs.mkdir(scratch + "/tests/fixtures")
  let cases : Array[(String, Bool)] = [
    ("nginx.ingress.kubernetes.io/proxy-ssl-secret: \"${NAMESPACE}/backend-tls\"", true),
    ("password: test-only-password", false),
    ("token: test-only-token", false),
    ("secret: test-only-secret", false),
    ("tlsSecret: local-tls password: test-only-password", false),
    ("nginx.ingress.kubernetes.io/proxy-ssl-secret: namespace/*", false),
    ("automountServiceAccountToken: false", true),
    ("automountServiceAccountToken: true", false),
  ]
  for index, entry in cases {
    let (source, accepted) = entry
    @fs.write_file(scratch + "/deploy/fixture.yaml", source)
    let result = @shell.Cmd("moon", ["run", "scripts/check-deployment-secrets.mbtx", "--root", scratch]).output()
    guard (result.exit_code() == 0) == accepted else { fail("Secret scan process fixture \{index} returned the wrong result") }
    for literal in ["test-only-password", "test-only-token", "test-only-secret"] {
      assert_false(result.stdout().contains(literal))
      assert_false(result.stderr().contains(literal))
    }
  }
  println("Secret scanner process fixtures: 8 passed; rejected values are redacted")
}
