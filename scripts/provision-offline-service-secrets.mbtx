import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

async fn secret_random() -> String {
  let result = @shell.Cmd("openssl", ["rand", "-hex", "32"]).output()
  result.check()
  result.stdout().trim().to_owned()
}

async fn main {
  guard @env.args() is [_, root, kubeconfig] else { fail("Usage: provision-offline-service-secrets.mbtx NEW_PRIVATE_DIR KUBECONFIG") }
  @fs.mkdir(root, permission=0o700)
  let kubectl = ["--kubeconfig", kubeconfig, "-n", "lunanexa"]
  let current = @shell.Cmd("kubectl", [..kubectl, "get", "secret", "lunanexa-offline-transfer", "--ignore-not-found", "-o", "name"]).output()
  current.check()
  guard current.stdout().trim() == "" else { fail("Existing production transfer secret: refusing to rotate it implicitly") }
  let controller_result = @shell.Cmd("kubectl", [..kubectl, "get", "secret", "lunanexa-control-credentials", "-o", "json"]).output()
  controller_result.check()
  let controller = @json.parse(controller_result.stdout())
  guard controller is {"data": {"artifact-scanner-callback-token": String(scanner), ..}, ..} else { fail("Missing existing scanner callback secret") }
  let adapter = secret_random()
  let access = "LN" + secret_random()[:20].to_owned()
  let password = secret_random()
  let admin_access = "LNBOOT" + secret_random()[:16].to_owned()
  let admin_password = secret_random()
  let iam : Json = {"identities": [
    {"name": "offline-adapter", "credentials": [{"accessKey": access, "secretKey": password}], "actions": ["Read:lunanexa-offline-commerce", "Write:lunanexa-offline-commerce", "List:lunanexa-offline-commerce"]},
    {"name": "offline-bootstrap", "credentials": [{"accessKey": admin_access, "secretKey": admin_password}], "actions": ["Admin"]},
  ]}
  let resources : Array[Json] = [
    {"apiVersion": "v1", "kind": "Secret", "metadata": {"name": "lunanexa-offline-transfer", "namespace": "lunanexa"}, "type": "Opaque", "data": {"LUNANEXA_ARTIFACT_SCANNER_CALLBACK_TOKEN": scanner}, "stringData": {"LUNANEXA_OFFLINE_TRANSFER_ADAPTER_TOKEN": adapter}},
    {"apiVersion": "v1", "kind": "Secret", "metadata": {"name": "lunanexa-offline-s3", "namespace": "lunanexa"}, "type": "Opaque", "stringData": {"credentials": "[default]\naws_access_key_id = " + access + "\naws_secret_access_key = " + password + "\n"}},
    {"apiVersion": "v1", "kind": "Secret", "metadata": {"name": "lunanexa-offline-s3-bootstrap", "namespace": "lunanexa"}, "type": "Opaque", "stringData": {"credentials": "[default]\naws_access_key_id = " + admin_access + "\naws_secret_access_key = " + admin_password + "\n"}},
    {"apiVersion": "v1", "kind": "Secret", "metadata": {"name": "lunanexa-offline-object-store-iam", "namespace": "lunanexa"}, "type": "Opaque", "stringData": {"iam.json": iam.stringify(), "sts.key": secret_random()}},
  ]
  @fs.write_file(root + "/secrets.json", ({"apiVersion": "v1", "kind": "List", "items": resources} : Json).stringify(), create_mode=CreateNew, permission=0o600)
  @shell.Cmd("openssl", ["req", "-x509", "-nodes", "-newkey", "rsa:3072", "-days", "365", "-keyout", root + "/ca.key", "-out", root + "/ca.crt", "-subj", "/CN=LunaNexa Offline Private CA 20260922"]).run()
  @shell.Cmd("chmod", ["600", root + "/ca.key"]).run()
  for service in ["lunanexa-offline-transfer", "lunanexa-offline-object-store", "lunanexa-offline-controller"] {
    let stem = root + "/" + service
    @fs.write_file(stem + ".ext", "subjectAltName=DNS:" + service + ".lunanexa.svc,DNS:" + service + ".lunanexa.svc.cluster.local\nextendedKeyUsage=serverAuth\n", create_mode=CreateNew, permission=0o600)
    @shell.Cmd("openssl", ["req", "-new", "-nodes", "-newkey", "rsa:3072", "-keyout", stem + ".key", "-out", stem + ".csr", "-subj", "/CN=" + service + ".lunanexa.svc"]).run()
    @shell.Cmd("chmod", ["600", stem + ".key"]).run()
    @shell.Cmd("openssl", ["x509", "-req", "-in", stem + ".csr", "-CA", root + "/ca.crt", "-CAkey", root + "/ca.key", "-CAcreateserial", "-out", stem + ".crt", "-days", "90", "-sha256", "-extfile", stem + ".ext"]).run()
    @shell.Cmd("kubectl", [..kubectl, "create", "secret", "tls", service + "-tls", "--cert=" + stem + ".crt", "--key=" + stem + ".key"]).run()
  }
  @shell.Cmd("kubectl", [..kubectl, "create", "configmap", "lunanexa-offline-ca", "--from-file=ca.crt=" + root + "/ca.crt"]).run()
  @shell.Cmd("kubectl", [..kubectl, "create", "-f", root + "/secrets.json"]).run()
  println("Provisioned private TLS and scoped service secrets; existing callback authority was reused. Private files remain in " + root)
}
