import { "moonbitlang/async", "moonbitlang/async/fs", "moonbitlang/async/shell", "moonbitlang/core/env" }
async fn main {
  guard @env.args() is [_, kubeconfig, private_dir, image, revision] else { fail("Usage: deploy-offline-web.mbtx KUBECONFIG PRIVATE_DIR PINNED_IMAGE REVISION") }
  let coursebook = image.has_prefix("lunanexa-registry.lunanexa-registry.svc.cluster.local:5000/moon/coursebook@sha256:")
  guard (coursebook || image.has_prefix("lunanexa-registry.lunanexa-registry.svc.cluster.local:5000/moon/lunanexa-web@sha256:")) && revision.all(c => c is ('a'..='z' | '0'..='9' | '-')) && !revision.is_empty() else { fail("Invalid pinned image or revision") }
  let k=["--kubeconfig",kubeconfig,"-n","lunanexa"]
  let targets=if coursebook { [("lunanexa-coursebook-public-gateway","gateway")] } else { [("lunanexa-console","console"),("lunanexa-enterprise","enterprise"),("lunanexa-workbench","workbench")] }
  for target in targets {
    let (deployment, _) = target
    let before=@shell.Cmd("kubectl",[..k,"get","deployment",deployment,"-o","json"]).output()
    before.check()
    @fs.write_file(private_dir+"/"+deployment+"-before-"+revision+".json",before.stdout(),create_mode=CreateNew,permission=0o600)
  }
  for target in targets {
    let (deployment, container) = target
    @shell.Cmd("kubectl",[..k,"set","image","deployment/"+deployment,container+"="+image]).run()
  }
  for target in targets {
    let (deployment, _) = target
    @shell.Cmd("kubectl",[..k,"rollout","status","deployment/"+deployment,"--timeout=120s"]).run()
  }
}
