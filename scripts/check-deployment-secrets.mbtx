///|
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn dns_name(value : String, maximum : Int) -> Bool {
  value.length() > 0 &&
  value.length() <= maximum &&
  value
  .split(".")
  .all(part => {
    part.length() > 0 &&
    part.length() <= 63 &&
    !part.has_prefix("-") &&
    !part.has_suffix("-") &&
    part.all(c => (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-')
  })
}

///|
fn unquote(value : String) -> String {
  if value.length() >= 2 &&
    (
      (value.has_prefix("\"") && value.has_suffix("\"")) ||
      (value.has_prefix("'") && value.has_suffix("'"))
    ) {
    value[1:value.length() - 1].to_owned()
  } else {
    value
  }
}

///|
fn placeholder(value : String) -> Bool {
  value.length() >= 4 &&
  value.length() <= 131 &&
  value.has_prefix("${") &&
  value.has_suffix("}") &&
  value[2:value.length() - 1].all(c => {
    (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
  }) &&
  !(value[2] >= '0' && value[2] <= '9')
}

// A shell reference is not a literal credential. Accept only a complete
// parameter expansion (optionally nested as an array index) and an empty
// fallback. Concatenated text, command substitution and nonempty defaults
// remain suspicious. Do not evaluate shell syntax during scanning.

///|
fn shell_identifier(value : String) -> Bool {
  !value.is_empty() &&
  !(value[0] >= '0' && value[0] <= '9') &&
  value.all(c => {
    (c >= 'a' && c <= 'z') ||
    (c >= 'A' && c <= 'Z') ||
    (c >= '0' && c <= '9') ||
    c == '_'
  })
}

///|
fn shell_parameter_reference(value : String, depth : Int) -> Bool {
  guard depth <= 4 &&
    value.length() >= 4 &&
    value.length() <= 256 &&
    value.has_prefix("${") &&
    value.has_suffix("}") else {
    return false
  }
  let enclosed = value[2:value.length() - 1].to_owned()
  let body = if enclosed.has_suffix(":-") {
    enclosed[:enclosed.length() - 2].to_owned()
  } else {
    enclosed
  }
  if body.find("[") is Some(index) {
    body.has_suffix("]") &&
    shell_identifier(body[:index].to_owned()) &&
    shell_parameter_reference(
      body[index + 1:body.length() - 1].to_owned(),
      depth + 1,
    )
  } else {
    shell_identifier(body)
  }
}

///|
fn safe_shell_reference_line(source : String) -> Bool {
  guard source.has_prefix("local ") && source.find("=") is Some(equal) else {
    return false
  }
  let name = source[6:equal].trim().to_owned()
  let quoted = source[equal + 1:].trim().to_owned()
  shell_identifier(name) &&
  quoted.length() >= 2 &&
  quoted.has_prefix("\"") &&
  quoted.has_suffix("\"") &&
  shell_parameter_reference(unquote(quoted), 0)
}

///|
fn safe_reference_line(line : String) -> Bool {
  let source = line.trim().to_owned()
  if safe_shell_reference_line(source) {
    return true
  }
  guard source.find(":") is Some(colon) else { return false }
  let key = unquote(source[:colon].trim().to_owned())
  let value = unquote(source[colon + 1:].trim().to_owned())
  if key == "automountServiceAccountToken" {
    return value == "false"
  }
  if key == "revokeRefreshToken" {
    return value == "true" || value == "false"
  }
  let qualified = key == "nginx.ingress.kubernetes.io/auth-tls-secret" ||
    key == "nginx.ingress.kubernetes.io/proxy-ssl-secret"
  if !qualified && key != "tlsSecret" {
    return false
  }
  let parts = value.split("/").map(part => part.to_owned()).collect()
  match parts {
    [namespace_name, name] =>
      (
        placeholder(namespace_name) ||
        (dns_name(namespace_name, 63) && !namespace_name.contains("."))
      ) &&
      (placeholder(name) || dns_name(name, 253))
    [name] if !qualified => placeholder(name) || dns_name(name, 253)
    _ => false
  }
}

///|
fn self_test() -> Unit raise {
  for
    source in [
      "automountServiceAccountToken: false", "revokeRefreshToken: true", "tlsSecret: local-tls",
      "tlsSecret: namespace/local-tls", "nginx.ingress.kubernetes.io/auth-tls-secret: namespace/client-ca",
      "nginx.ingress.kubernetes.io/proxy-ssl-secret: \"namespace/backend-tls\"",
      "nginx.ingress.kubernetes.io/proxy-ssl-secret: \"${NAMESPACE}/backend-tls\"",
      "tlsSecret: \"${TLS_SECRET}\"", "local sudo_password=\"${MANAGEMENT_SUDO}\"",
      "local password=\"${NODE_SUDO[${NODE_USER[${node}]}]:-}\"",
    ] {
    assert_true(safe_reference_line(source))
  }
  for
    source in [
      "password: test-only-password",
      "token: test-only-token",
      "secret: test-only-secret",
      "automountServiceAccountToken: true",
      "automountServiceAccountToken: false password: test-only-password",
      "revokeRefreshToken: test-only-secret",
      "tlsSecret: local-tls password: test-only-password",
      "nginx.ingress.kubernetes.io/proxy-ssl-secret: inline-secret",
      "nginx.ingress.kubernetes.io/proxy-ssl-secret: namespace/../secret",
      "nginx.ingress.kubernetes.io/proxy-ssl-secret: namespace/*",
      "nginx.ingress.kubernetes.io/proxy-ssl-secret: namespace/name token: test-only-token",
      "nginx.ingress.kubernetes.io/proxy-ssl-secret: namespace/\"name",
      "nginx.ingress.kubernetes.io/proxy-ssl-secret: namespace/" +
      "a".repeat(64),
      "nginx.ingress.kubernetes.io/proxy-ssl-secret: ${NAMESPACE:-default}/name",
      "tlsSecret: ${TLS_SECRET} password: test-only-password",
      "local password=\"literal-secret\"",
      "local password=\"${TOKEN:-literal-secret}\"",
      "local password=\"${TOKEN}literal-secret\"",
      "local password=\"$(read-secret)\"",
      "local password=\"${TOKEN}\"; token=literal-secret",
      "local password=\"${TOKENS[literal-secret]}\"",
    ] {
    assert_false(safe_reference_line(source))
  }
}

///|
async fn main {
  self_test()
  if @env.args().contains("--self-test") {
    println("Secret-reference classification fixtures: 31 passed")
    return
  }
  let mut root = "."
  let args = @env.args()
  for index, arg in args {
    if arg == "--root" {
      guard args.get(index + 1) is Some(value) && value != "" else {
        fail("Missing scan root")
      }
      root = value
    }
  }
  let result = @shell.Cmd("rg", [
    "--json",
    "-i",
    "(password|token|secret)[[:space:]]*[:=][[:space:]]*[^$<{[:space:]][^[:space:]]+",
    root + "/deploy",
    root + "/tests/fixtures",
  ]).output()
  guard result.exit_code() == 0 || result.exit_code() == 1 else {
    fail("Secret scan could not read the deployment/fixture tree")
  }
  let failures : Array[String] = []
  for line in result.stdout().split("\n") {
    if line == "" {
      continue
    }
    let event = @json.parse(line) catch {
      _ => fail("Secret scanner received malformed search output")
    }
    if event
      is {
        "type": "match",
        "data": {
          "path": { "text": String(path), .. },
          "line_number": Number(number, ..),
          "lines": { "text": String(source), .. },
          ..
        },
        ..
      } &&
      !safe_reference_line(source) {
      failures.push(path + ":" + number.to_int().to_string())
    }
  }
  for location in failures {
    println(location + ": possible literal secret (value withheld)")
  }
  if !failures.is_empty() {
    fail("Deployment secret scan failed")
  }
  println(
    "Deployment literal-secret heuristic passed; references were validated, values withheld",
  )
}
