///|
import { "moonbitlang/async@0.22.4", "moonbitlang/async@0.22.4/fs", "moonbitlang/core/json" }

///|
fn bilingual(pair : Json) -> Json raise {
  guard pair is [String(zh),String(en)] else { fail("Missing bilingual text") }
  { "zh": zh,"en": en }
}

///|
fn label(value : Json, language : String) -> String raise {
  guard value is Object(fields) && fields.get(language) is Some(String(text)) else { fail("Missing label") }
  text
}

///|
fn sentence(text : String, language : String) -> String {
  let mark=if language=="zh" { "。" } else { ". " }
  text.split(mark).next().unwrap().to_owned()+(if language=="zh" { "。" } else { "." })
}

///|
fn comparison(columns : Array[(String,String,Array[(String,String)])], caption : (String,String)) -> Json raise {
  let beats : Array[Json]=columns.map(column=>bilingual([Json::string(column.2.map(v=>v.0).join("；")),Json::string(column.2.map(v=>v.1).join("; "))]))
  let rendered : Array[Json]=columns.map(column=>{ let item : Json={"title":{"zh":column.0,"en":column.1},"lines":Json::array(column.2.map(v=>bilingual([Json::string(v.0),Json::string(v.1)])))};item })
  let motion : Array[Json]=columns.map(_=>{ let item : Json={"kind":"write","duration":1600};item })
  { "type":"compare","columns":rendered,"steps":columns.map(column=>bilingual([Json::string(column.0),Json::string(column.1)])),"beats":beats,"motion":motion,"caption":{"zh":caption.0,"en":caption.1} }
}

///|
async fn main {
  guard @json.parse(@fs.read_file("docs/ai-integrated-course.json").text()) is {"groups":Array(group_specs),"lessons":Array(plan),..} && @json.parse(@fs.read_file("output/ai-course-authoring/base.json").text()) is {"lessons":Array(base_lessons),..} && @json.parse(@fs.read_file("docs/ai-whiteboard/figures.json").text()) is Object(figures) && @json.parse(@fs.read_file("docs/ai-whiteboard/inspection.json").text()) is {"images":Array(images),"uncertain_readings":uncertainties,..} else { fail("Missing integrated sources") }
  let old : Map[String,Json]=Map([])
  for lesson in base_lessons { guard lesson is {"slides":Array(slides),..} else { fail("Base lesson") };for slide in slides { guard slide is {"id":String(id),..} else { fail("Base slide") };old[id]=slide } }
  let sections : Map[String,Json]=Map([])
  let provenance : Map[String,Json]=Map([])
  let references : Map[String,Json]=Map([])
  let files=["01-models-and-engineering.json","02-agent-feedback.json","03-rules-learning-systems.json","04-training-and-evaluation.json","05-scaling-and-infrastructure.json","06-model-selection.json","07-agent-harness-model.json"]
  for i,file in files {
    guard @json.parse(@fs.read_file("docs/ai-whiteboard/"+file).text()) is {"sections":Array(items),"references":refs,..} else { fail("Invalid board source") }
    for item in items { guard item is {"id":String(id),..} else { fail("Section") };sections[id]=item;provenance[id]={"order":i+1,"download_rank":7-i,"source_id":"whiteboard-"+(i+1).to_string(),"image":images[i]};references[id]=refs }
  }
  let custom : Map[String,Json]=Map([])
  custom["testtime"]=comparison([("直接给候选","One proposed answer",[("问题：17 × 23","Question: 17 × 23"),("教学候选：381","Toy proposal: 381"),("尚未计算核对","No calculation check yet")]),("增加计算与核对","Compute and check",[("计算器：17 × 23","Calculator: 17 × 23"),("得到 391","Result: 391"),("核对后修正为 391","Revise the answer to 391")])],("教学候选不是产品实测；新增步骤提供有效反馈才可能帮助任务。","The proposal is synthetic, not measured. Extra work helps when it supplies useful feedback."))
  custom["article"]=comparison([("笼统要求","Vague request",[("帮我写文章。","Write an article."),("主题、受众与材料？","Subject, audience, material?")]),("明确模板","Explicit template",[("面向首次参加者","For first-time attendees"),("第一段：活动背景","Paragraph 1: background"),("第二段：时间与参加方式","Paragraph 2: when/how to join")]),("填入真实材料","Supply real material",[("通知：周四 14:00","Notice: Thursday 14:00"),("地点：报告厅","Location: auditorium"),("根据通知整理两段","Use the notice for two paragraphs")])],("模板规定结构，实际通知提供事实；下一步把这些材料组织成上下文。","The template specifies structure; the notice supplies facts. Next assemble the material as context."))
  custom["rules"]=comparison([("人工规则","Written rules",[("温度高 + 风扇停","Hot + fan stopped"),("→ 检查散热","→ inspect cooling")]),("知识图谱","Knowledge graph",[("皇帝 → 别称 → 皇上","Emperor → alias → sovereign"),("显式实体与关系","Explicit entities and links")]),("从样本学习","Learn from examples",[("(1,5), (2,7), (3,9)","(1,5), (2,7), (3,9)"),("调整 a、b","Adjust a and b")])],("同一类问题可以组合规则、检索和学习。","Rules, retrieval and learning can be combined."))
  custom["corpus"]=comparison([("训练样本","Training examples",[("文本 → Token 序列","Text → token sequences"),("前文 → 真实后续","Prefix → observed next"),("样本用于调整参数","Examples update parameters")]),("参数数量单位","Parameter counts",[("K = 10³；M = 10⁶","K = 10³; M = 10⁶"),("B = 10⁹；T = 10¹²","B = 10⁹; T = 10¹²"),("B 不等于 Byte","B does not mean byte")])],("Token 数量、参数数量和存储空间，是不同的量。","Token counts, parameter counts and storage are different quantities."))
  custom["stages"]=comparison([("预训练","Pretraining",[("广泛文本与代码","Broad text and code"),("学习一般模式","Learn broad patterns")]),("继续／中训练","Continued / mid",[("集中材料或目标","Focused data or objectives"),("例如长上下文、领域","E.g. long context or domain")]),("后训练","Post-training",[("示范、偏好与奖励","Examples, preferences, rewards"),("塑造任务行为","Shape task behavior")])],("中训练并非统一必经阶段；RLHF 是后训练方法之一。","Mid-training is not a universal required phase; RLHF is one post-training method."))
  custom["signals"]=comparison([("SFT：给示范","SFT: demonstrations",[("输入：会议原文","Input: meeting transcript"),("目标：事项／人／日期","Target: task / owner / date"),("学习示范输出的概率","Learn demonstrated output")]),("RL：看结果","RL: outcome feedback",[("输入：编程问题","Input: coding problem"),("生成程序 → 运行测试","Generate → execute tests"),("结果评分 → 学习信号","Outcome score → learning")])],("两种信号都能用于工程与科学；粘贴范例不等于更新参数。","Both signals serve engineering and science; pasting an example is not a parameter update."))
  custom["size"]=comparison([("参数数量","Parameter count",[("2.8 T","2.8 T"),("2.8 × 10¹² 个数","2.8 × 10¹² values")]),("每个值的空间","Space per value",[("16 bit = 2 Byte","16 bit = 2 bytes"),("统一精度粗算","Uniform-precision estimate")]),("原始权重","Raw weights",[("2.8 × 10¹² × 2","2.8 × 10¹² × 2"),("≈ 5.6 TB","≈ 5.6 TB")])],("十进制单位；未包含缓存、工作区、梯度或优化器。","Decimal units; excludes caches, workspace, gradients and optimizer state."))
  custom["modalities"]=comparison([("图像理解","Image understanding",[("输入：图片 + 问题","Input: image + question"),("输出：文字描述","Output: description")]),("图像生成","Image generation",[("输入：文字或图片","Input: text or image"),("输出：图像","Output: image")]),("视频生成","Video generation",[("输入：文字／参考素材","Input: text / reference"),("输出：视频序列","Output: video")])],("先看具体模型的输入输出规格；同一公司可以提供多种模型。","Read the specific model's input/output specification; a company can offer several model types."))
  let lessons : Array[Json]=[]
  let used : Map[String,Json]=Map([])
  let all_frames : Array[Json]=[]
  let mut primary_minutes=0
  let mut elapsed=0
  for chapter_number,chapter in plan {
    guard chapter is {"id":String(page_id),"group":String(group_id),"title":title,"frames":Array(frame_specs),..} else { fail("Invalid plan chapter") }
    let book_sections : Array[Json]=[]
    let slides : Array[Json]=[]
    let source_ids : Array[Json]=["ai-foundations","lecture-authoring","lecture-studio","lecture-storyboard","lecture-playback","integrated-authoring","integrated-plan","integrated-teaching","whiteboard-authoring","whiteboard-inspection","whiteboard-figures","whiteboard-studio","whiteboard-coverage"]
    let page_references : Array[Json]=[]
    for spec in frame_specs {
      guard spec is Object(spec_fields) && spec_fields.get("minutes") is Some(Number(minutes,..)) else { fail("Invalid duration") }
      let primary=spec_fields.get("sections").unwrap_or(Json::array([]))
      let (id,visual,slide_fields) = if spec_fields.get("old") is Some(String(id)) {
        guard old.get(id) is Some(source) && @json.parse(source.stringify()) is Object(fields) && fields.get("visual") is Some(visual) else { fail("Missing supporting scene "+id) }
        (id,visual,fields)
      } else {
        guard spec_fields.get("id") is Some(String(id)) && spec_fields.get("visual") is Some(String(key)) && primary is Array(ids) && ids.length()>0 && ids[0] is String(first) && sections.get(first) is Some({"title":section_title,"paragraphs":Array(paragraphs),..}) else { fail("Missing primary section") }
        let selected=if key.has_prefix("@") { figures.get(key[1:].to_owned()).unwrap() } else if key.has_prefix("$") { custom.get(key[1:].to_owned()).unwrap() } else { guard old.get(key) is Some({"visual":visual,..}) else { fail("Missing visual "+key) };visual }
        let visual=@json.parse(selected.stringify())
        guard paragraphs[0] is [String(zh),String(en)] else { fail("Missing explanation") }
        let lead : Json={"zh":sentence(zh,"zh"),"en":sentence(en,"en")}
        let fields : Map[String,Json]=Map([("id",Json::string(id)),("title",bilingual(section_title)),("lead",lead),("key",bilingual(spec_fields.get("key").unwrap()))])
        (id,visual,fields)
      }
      slide_fields["minutes"]=Json::number(minutes);slide_fields["visual"]=visual;slide_fields["source_sections"]=primary;slide_fields["start"]=Json::number(elapsed.to_double());slide_fields["page_id"]=Json::string(page_id)
      if primary is Array(ids) && ids.length()>0 {
        primary_minutes+=minutes.to_int()
        let zh_notes : Array[Json]=[]
        let en_notes : Array[Json]=[]
        let visual_at=spec_fields.get("visual_at").unwrap_or(ids[0])
        for section_id in ids {
          guard section_id is String(section_id) && !used.contains(section_id) && sections.get(section_id) is Some(Object(section)) && section.get("paragraphs") is Some(Array(paragraphs)) && provenance.get(section_id) is Some({"source_id":source_id,..}) && references.get(section_id) is Some(Array(refs)) else { fail("Repeated or missing source section") }
          used[section_id]={"page_id":page_id,"slide_id":id,"start":elapsed,"minutes":minutes}
          if !source_ids.contains(source_id) { source_ids.push(source_id) }
          for citation in refs { if !page_references.contains(citation) { page_references.push(citation) } }
          let object : Map[String,Json]=Map([])
          for k,v in section { object[k]=v }
          object["slide_id"]=Json::string(id);object["primary"]=true
          if Json::string(section_id)==visual_at { object["visual"]=visual }
          book_sections.push(Json::object(object))
          for paragraph in paragraphs { guard paragraph is [String(zh),String(en)] else { fail("Paragraph") };zh_notes.push(Json::string(zh));en_notes.push(Json::string(en)) }
        }
        slide_fields["primary_notes"]={"zh":zh_notes,"en":en_notes}
        if visual is Object(v) && v.get("type")==Some(Json::string("board")) { v["scene"]=Json::string(id) }
      } else {
        guard slide_fields.get("title") is Some(title) && slide_fields.get("teaching") is Some({"opening":opening,"concepts":concepts,"takeaway":takeaway,..}) && slide_fields.get("key") is Some(key) else { fail("Support copy") }
        let terms : Array[Json]=if concepts is Array(terms) { terms.copy() } else { [] }
        terms.push(Json::string(label(takeaway,"zh")));terms.push(Json::string(label(takeaway,"en")))
        book_sections.push({"id":id,"title":[label(title,"zh"),label(title,"en")],"paragraphs":[[label(opening,"zh").replace_all(old="计时边界",new="计时起止点"),label(opening,"en")],[label(key,"zh"),label(key,"en")]],"visual":visual,"slide_id":id,"primary":false,"concepts":terms})
      }
      slides.push(Json::object(slide_fields));all_frames.push(Json::object(slide_fields));elapsed+=minutes.to_int()
    }
    if page_id=="ai-multi-agent" { guard elapsed==50 else { fail("First half must finish at 50: "+elapsed.to_string()) };elapsed+=10 }
    if page_id=="ai-platform-place" { source_ids.push("product-contract");source_ids.push("architecture") }
    lessons.push({"page_id":page_id,"group_id":group_id,"title":bilingual(title),"chapter_number":chapter_number+1,"slides":slides,"sections":book_sections,"source_ids":source_ids,"references":page_references})
  }
  guard used.length()==47 && elapsed==115 else { fail("Incomplete 47-section / 115-minute integration: "+used.length().to_string()+" / "+elapsed.to_string()) }
  guard @json.parse(@fs.read_file("docs/ai-integrated-teaching.json").text()) is Object(rehearsal) else { fail("Missing integrated rehearsal") }
  for frame in all_frames {
    guard frame is Object(fields) && fields.get("id") is Some(String(id)) && fields.get("visual") is Some(Object(visual)) else { fail("Scene") }
    if rehearsal.get("_titles") is Some(Object(titles)) && titles.get(id) is Some(title) { fields["title"]=bilingual(title) }
    if rehearsal.get("_beats") is Some(Object(overrides)) && overrides.get(id) is Some(Array(beats)) { visual["beats"]=Json::array(beats.map(beat=>bilingual(beat))) }
    guard visual.get("steps") is Some(Array(steps)) && visual.get("beats") is Some(Array(beats)) && fields.get("minutes") is Some(Number(minutes,..)) && fields.get("title") is Some(title) && fields.get("key") is Some(key) else { fail("Incomplete classroom scene") }
    if !visual.contains("scene") { visual["scene"]=Json::string(id) }
    guard rehearsal.get("_transitions") is Some(Object(transitions)) && transitions.get(id) is Some(bridge) else { fail("Missing causal connection: "+id) }
    let transition=bilingual(bridge)
    let notes_zh : Array[Json]=[]
    let notes_en : Array[Json]=[]
    for beat in beats { notes_zh.push(Json::string(label(beat,"zh")));notes_en.push(Json::string(label(beat,"en"))) }
    notes_zh.push(Json::string(label(transition,"zh")));notes_en.push(Json::string(label(transition,"en")))
    fields["notes"]={"zh":notes_zh,"en":notes_en};fields["transition"]=transition
    let teaching : Map[String,Json]=if visual.get("scene") is Some(String(scene)) && old.get(scene) is Some({"teaching":source,..}) && @json.parse(source.stringify()) is Object(t) { t } else { Map([]) }
    if rehearsal.get(id) is Some({"questions":Array(pairs),"demonstration":demo,"pause":pause,..}) {
      guard pairs.length()==3 else { fail("Need three student questions: "+id) }
      let questions : Array[Json]=[]
      for n,pair in pairs { guard pair is [question,answer] else { fail("Question pair") };questions.push({"kind":["why","how","link"][n],"question":bilingual(question),"answer":bilingual(answer)}) }
      teaching["questions"]=Json::array(questions);teaching["demonstration"]=bilingual(demo);teaching["pause"]=bilingual(pause)
    }
    guard teaching.get("questions") is Some(Array(questions)) && questions.length()==3 else { fail("Missing rehearsal for "+id) }
    // All links follow the final curriculum rather than an earlier slide order.
    if questions[2] is Object(connection) { connection["question"]={"zh":"这一页怎样接到下一步？","en":"How does this connect to the next step?"};connection["answer"]=transition }
    if fields.get("source_sections") is Some(Array(ids)) && ids.length()>0 { teaching["opening"]=fields["lead"] }
    teaching["concepts"]=fields.get("source_sections").unwrap_or(Json::array([]));teaching["takeaway"]=key
    let total=minutes.to_int()*60
    let demo=if total>=180 { 40 } else if total>=120 { 25 } else { 12 }
    let observation=if total>=120 { 15 } else { 7 }
    teaching["pacing"]=if total==60 { {"speech_seconds":35,"demo_seconds":10,"processing_seconds":5,"question_seconds":0,"transition_seconds":5,"margin_seconds":5} } else { {"speech_seconds":total-demo-observation-15,"demo_seconds":demo,"processing_seconds":observation,"question_seconds":5,"transition_seconds":5,"margin_seconds":5} }
    teaching["minutes"]=Json::number(minutes)
    teaching["recovery"]={"seconds":0,"instruction":{"zh":"保留例子和原理说明。","en":"Keep the worked example and mechanism."}}
    teaching["title"]=title;teaching["stage_count"]=Json::number(steps.length().to_double());fields["teaching"]=Json::object(teaching)
  }
  let outline : Array[Json]=[]
  let concept_outline : Array[Json]=[]
  for group in group_specs {
    guard group is {"id":String(group_id),"title":title,..} else { fail("Group") }
    let items : Array[Json]=[]
    let concepts : Array[Json]=[]
    for lesson in lessons {
      guard lesson is {"page_id":String(page_id),"group_id":String(candidate),"slides":Array(slides),"sections":Array(book_sections),..} else { fail("Lesson") }
      if candidate!=group_id { continue }
      for slide in slides {
        guard slide is {"id":String(id),"title":title,"key":key,"start":start,"minutes":minutes,"source_sections":primary,..} else { fail("Frame") }
        let words : Array[Json]=[]
        if primary is Array(ids) { for section_id in ids { guard section_id is String(section_id) && sections[section_id] is {"concepts":Array(terms),..} else { fail("Keywords") };for term in terms { words.push(term) } } }
        if words.length()==0 && old.get(id) is Some({"teaching":{"concepts":Array(terms),"takeaway":takeaway,..},..}) { for term in terms { words.push(term) };words.push(Json::string(label(takeaway,"zh")));words.push(Json::string(label(takeaway,"en"))) }
        let anchor=if primary is Array(ids) && ids.length()>0 && ids[0] is String(first) { "concept-"+first } else { "concept-"+id }
        items.push({"id":id,"page_id":page_id,"anchor":anchor,"title":title,"takeaway":key,"concepts":words,"start":start,"minutes":minutes})
      }
      for section in book_sections {
        guard section is {"id":String(id),"title":title,"slide_id":String(slide_id),"paragraphs":Array(paragraphs),"concepts":words,..} && slides.search_by(s=>s is {"id":String(candidate),..} && candidate==slide_id) is Some(index) && slides[index] is {"start":start,"minutes":minutes,..} && paragraphs[0] is [String(zh),String(en)] else { fail("Concept link") }
        let search_words=if words is Array(terms) && terms.length()==0 && old.get(slide_id) is Some({"teaching":{"concepts":terms,..},..}) { terms } else { words }
        concepts.push({"id":id,"slide_id":slide_id,"page_id":page_id,"anchor":"concept-"+id,"title":bilingual(title),"takeaway":{"zh":sentence(zh,"zh"),"en":sentence(en,"en")},"concepts":search_words,"start":start,"minutes":minutes})
      }
    }
    guard items[0] is {"start":start,..} && items[items.length()-1] is {"start":Number(last_start,..),"minutes":Number(last_minutes,..),..} else { fail("Empty teaching group") }
    outline.push({"id":group_id,"title":bilingual(title),"start":start,"end":last_start+last_minutes,"items":items});concept_outline.push({"id":group_id,"title":bilingual(title),"items":concepts})
  }
  let coverage : Array[Json]=[]
  let mut audit="# 板书内容融入主课：逐点对照\n\n七张原图按第 7→1 张记录来源。186 个可辨认条目均进入正常章节正文和对应投屏讲稿，不再保留独立的板书阅读路线。\n\n"
  for i,file in files {
    guard @json.parse(@fs.read_file("docs/ai-whiteboard/"+file).text()) is {"sections":Array(items),..} && images[i] is {"sha256":sha,..} else { fail("Source crosswalk") }
    audit+="## 原图第 "+(7-i).to_string()+" 张\n\n"
    let mut number=0
    for section in items {
      guard section is {"id":String(section_id),"points":Array(points),"title":[String(title),_],..} && used[section_id] is {"page_id":String(page_id),"slide_id":String(slide_id),..} else { fail("Unintegrated source") }
      for point in points {
        number+=1;let id="WB"+(i+1).to_string()+"-"+number.to_string();let anchor="concept-"+section_id
        coverage.push({"id":id,"order":i+1,"download_rank":7-i,"image_sha256":sha,"point":point,"page_id":page_id,"section_id":section_id,"anchor":anchor,"slide_id":slide_id,"primary":true})
        guard point is String(point) else { fail("Point label") };audit+="- "+id+" · "+point+" → ["+title+"](/docs/?page="+page_id+"#"+anchor+") · [投屏](/docs/?page="+page_id+"&view=lecture&slide="+slide_id+")\n"
      }
    }
  }
  audit+="\n## 待核对手写\n\n"
  if uncertainties is Array(readings) { for reading in readings { guard reading is {"location":String(location),"concept_id":String(concept),..} && used[concept] is {"page_id":String(page_id),..} else { fail("Untracked reading") };audit+="- "+location+"：相关讲解在 [本节](/docs/?page="+page_id+"#concept-"+concept+")；原文仍未确认。\n" } }
  let result : Json={"order":"7 → 6 → 5 → 4 → 3 → 2 → 1","integration":"primary-curriculum","images":images,"chapters":24,"sections":47,"mapped_points":coverage.length(),"points":coverage,"uncertain_readings":uncertainties,"primary_minutes":primary_minutes,"content_minutes":105,"content_slides":all_frames.length(),"scope":"All identifiable source concepts integrated into normal chapters and the main presentation. Uncertain handwriting remains explicitly open."}
  @fs.write_file("docs/ai-whiteboard-coverage.json",result.stringify(indent=2)+"\n");@fs.write_file("docs/AI_WHITEBOARD_COVERAGE_20261114.md",audit)
  let data : Json={"contract_version":"lunanexa.ai-lecture.v1","title":{"zh":"AI：从模型到实际工作","en":"AI: from models to actual work"},"break_after":"ai-multi-agent","break_minutes":10,"questions_minutes":5,"lessons":lessons,"outline":outline,"concept_outline":concept_outline,"curriculum":{"primary_sections":47,"source_points":coverage.length(),"primary_minutes":primary_minutes,"support_minutes":105-primary_minutes,"content_slides":all_frames.length()}}
  @fs.write_file("docs-site/ai-lecture.json",data.stringify(indent=2)+"\n")
  println("Integrated "+used.length().to_string()+" primary sections into "+lessons.length().to_string()+" chapters and "+all_frames.length().to_string()+" slides; primary teaching "+primary_minutes.to_string()+" /105 minutes")
}
