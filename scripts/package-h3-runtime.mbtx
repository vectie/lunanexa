///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn output(program : String, args : Array[String]) -> String {
  let result = @shell.Cmd(program, args).output()
  result.check()
  result.stdout().trim().to_owned()
}

///|
async fn digest(path : String) -> String {
  output("sha256sum", [path]).split(" ").next().unwrap().to_owned()
}

///|
async fn bytes(path : String) -> Int64 {
  let file = @fs.open(path, mode=ReadOnly)
  defer file.close()
  file.size()
}

///|
async fn blob(root : String, name : String, value : Json) -> Json {
  let path = root + "/" + name
  @fs.write_file(path, value.stringify(), create_mode=CreateNew)
  let hash = digest(path)
  let size = bytes(path)
  @fs.rename(path, root + "/blobs/sha256/" + hash)
  // OCI descriptor sizes are JSON numbers, not MoonBit's Int64 strings.
  { "digest": "sha256:" + hash, "size": Json::number(size.to_double()) }
}

///|
async fn normalize_tree(path : String) -> Unit {
  if @fs.kind(path, follow_symlink=false) == Directory {
    for entry in @fs.readdir(path, sort=true) {
      normalize_tree(path + "/" + entry)
    }
    @fs.chmod(path, 0o755)
  } else {
    @fs.chmod(path, 0o644)
  }
  @shell.Cmd("touch", ["-t", "200001010000", path]).run()
}

///|
async fn main {
  guard @env.args() is [_, base, expected_base, patches, root, image] else {
    fail(
      "Usage: package-h3-runtime.mbtx BASE_OCI_TAR EXPECTED_MANIFEST_SHA256 PATCH_DIRECTORY NEW_OUTPUT IMAGE",
    )
  }
  guard expected_base.has_prefix("sha256:") && expected_base.length() == 71 else {
    fail("Expected exact base manifest digest")
  }
  guard !@fs.exists(root) && !@fs.exists(root + ".oci.tar") else {
    fail("Output must be new")
  }
  // Explicit code-only inputs: never copy a container filesystem or model tree.
  let destinations : Array[(String, String)] = [
    (
      "minimax_h3_transformer.py", "vllm_omni/diffusion/models/minimax_h3/minimax_h3_transformer.py",
    ),
    ("serving_video.py", "vllm_omni/entrypoints/openai/serving_video.py"),
    ("progress_bar.py", "vllm_omni/diffusion/models/progress_bar.py"),
    ("api_server.py", "vllm_omni/entrypoints/openai/api_server.py"),
  ]
  for entry in @fs.readdir(patches, include_hidden=true) {
    guard destinations.any(pair => pair.0 == entry) else {
      fail("Unexpected patch input: " + entry)
    }
  }
  for (name, _) in destinations {
    guard @fs.kind(patches + "/" + name, follow_symlink=false) == Regular &&
      bytes(patches + "/" + name) > 0L &&
      bytes(patches + "/" + name) <= 1048576L else {
      fail("Expected bounded regular Python source: " + name)
    }
  }
  @fs.mkdir(root, permission=0o700)
  @shell.Cmd("tar", ["-xf", base, "-C", root]).run()
  let index = @json.parse(@fs.read_file(root + "/index.json").text())
  guard index is { "manifests": [{ "digest": String(manifest_hash), .. }], .. } &&
    manifest_hash == expected_base else {
    fail("Base manifest does not match reviewed digest")
  }
  let manifest_path = root + "/blobs/sha256/" + manifest_hash[7:].to_owned()
  guard "sha256:" + digest(manifest_path) == expected_base else {
    fail("Base manifest digest mismatch")
  }
  let manifest = @json.parse(@fs.read_file(manifest_path).text())
  guard manifest is Object(fields) &&
    manifest
    is {
      "config": { "digest": String(config_hash), .. },
      "layers": Array(layers),
      ..
    } else {
    fail("Invalid base manifest")
  }
  let config_path = root + "/blobs/sha256/" + config_hash[7:].to_owned()
  guard "sha256:" + digest(config_path) == config_hash else {
    fail("Base config digest mismatch")
  }
  let config = @json.parse(@fs.read_file(config_path).text())
  guard config is Object(config_fields) &&
    config
    is {
      "architecture": "arm64",
      "os": "linux",
      "config": Object(_),
      "rootfs": { "diff_ids": Array(diffs), .. },
      ..
    } else {
    fail("Expected Linux ARM64 base config")
  }
  let layer = root + "/patch-layer"
  let patch_digests : Map[String, Json] = Map([])
  for (name, destination) in destinations {
    let target = layer +
      "/usr/local/lib/python3.12/dist-packages/" +
      destination
    let parent = target[:target.rev_find("/").unwrap()].to_owned()
    if !@fs.exists(parent) {
      @fs.mkdir(parent, recursive=true)
    }
    @fs.write_file(
      target,
      @fs.read_file(patches + "/" + name),
      create_mode=CreateNew,
    )
    patch_digests[name] = Json::string("sha256:" + digest(target))
  }
  normalize_tree(layer)
  let archive = root + "/patch-layer.tar"
  let ownership = if output("uname", ["-s"]) == "Darwin" {
    ["--uid=0", "--gid=0", "--uname=root", "--gname=root"]
  } else {
    ["--owner=0", "--group=0", "--sort=name"]
  }
  @shell.Cmd(
    "tar",
    ownership + ["--format=ustar", "-C", layer, "-cf", archive, "."],
  ).run()
  diffs.push(Json::string("sha256:" + digest(archive)))
  @shell.Cmd("gzip", ["-n", "-k", archive]).run()
  let hash = digest(archive + ".gz")
  let size = bytes(archive + ".gz")
  @fs.rename(archive + ".gz", root + "/blobs/sha256/" + hash)
  layers.push({
    "mediaType": "application/vnd.oci.image.layer.v1.tar+gzip",
    "digest": "sha256:" + hash,
    "size": Json::number(size.to_double()),
  })
  fields["mediaType"] = Json::string(
    "application/vnd.oci.image.manifest.v1+json",
  )
  for entry in layers {
    guard entry is Object(layer_fields) else {
      fail("Invalid layer descriptor")
    }
    if layer_fields.get("mediaType") ==
      Some(Json::string("application/vnd.docker.image.rootfs.diff.tar.gzip")) {
      layer_fields["mediaType"] = Json::string(
        "application/vnd.oci.image.layer.v1.tar+gzip",
      )
    }
  }
  let history = match config_fields.get("history") {
    Some(Array(items)) => items
    _ => []
  }
  history.push({
    "created_by": "LunaNexa H3 reviewed compatibility patch layer",
  })
  config_fields["history"] = Json::array(history)
  guard blob(root, "patched-config.json", config) is Object(new_config) else {
    fail("Invalid config descriptor")
  }
  new_config["mediaType"] = Json::string(
    "application/vnd.oci.image.config.v1+json",
  )
  fields["config"] = Json::object(new_config)
  guard blob(root, "patched-manifest.json", manifest) is Object(descriptor) else {
    fail("Invalid manifest descriptor")
  }
  descriptor["mediaType"] = Json::string(
    "application/vnd.oci.image.manifest.v1+json",
  )
  descriptor["annotations"] = {
    "org.opencontainers.image.ref.name": image,
    "io.containerd.image.name": image,
  }
  descriptor["platform"] = { "architecture": "arm64", "os": "linux" }
  @fs.write_file(
    root + "/index.json",
    ({ "schemaVersion": 2, "manifests": [Json::object(descriptor)] } : Json).stringify(),
  )
  @shell.Cmd("tar", [
    "-C",
    root,
    "-cf",
    root + ".oci.tar",
    "oci-layout",
    "index.json",
    "blobs",
  ]).run()
  let receipt : Json = {
    "base_manifest": expected_base,
    "manifest": descriptor["digest"],
    "patches": Json::object(patch_digests),
    "image": image,
  }
  @fs.write_file(
    root + "/package-receipt.json",
    receipt.stringify(indent=2),
    create_mode=CreateNew,
  )
  println(receipt.stringify(indent=2))
}
