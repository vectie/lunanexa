///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn text(j : Json, key : String) -> String raise {
  guard j is Object(fields) && fields.get(key) is Some(String(s)) else {
    fail("missing deployment field " + key)
  }
  s
}

///|
fn quote(s : String) -> String {
  "'" + s.replace_all(old="'", new="'\\''") + "'"
}

///|
async fn remote_text(rank : Json, args : Array[String]) -> String {
  let result = @shell.Cmd("ssh", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ConnectTimeout=10",
    "-S",
    text(rank, "socket"),
    text(rank, "target"),
    args.map(quote).join(" "),
  ]).output()
  result.check()
  result.stdout()
}

///|
async fn remote(rank : Json, args : Array[String]) -> Unit {
  ignore(remote_text(rank, args))
}

///|
async fn copy(rank : Json, from : String, to : String) -> Unit {
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + text(rank, "socket"),
    from,
    text(rank, "target") + ":" + to,
  ]).run()
}

///|
fn unit(root : String, rank : Json, ordinal : Int32) -> String raise {
  let mode = if ordinal == 0 { "serve" } else { "rank1" }
  let value =
    $|[Unit]
    $|Description=LunaNexa-owned native GLM TP rank \{ordinal}
    $|After=network-online.target
    $|[Service]
    $|Type=simple
    $|WorkingDirectory=\{root}
    $|Environment=LD_LIBRARY_PATH=\{root}/nccl
    $|Environment=NCCL_DEBUG=WARN
    $|Environment=NCCL_SOCKET_IFNAME=\{text(rank, "interface")}
    $|Environment=NCCL_IB_HCA=\{text(rank, "hca")}
    $|ExecStart=\{root}/glm_service.exe \{mode} \{root} service.json
    $|ExecStopPost=/usr/bin/echo GLM_UNIT_EXIT result=${SERVICE_RESULT} code=${EXIT_CODE} status=${EXIT_STATUS}
    $|KillMode=mixed
    $|TimeoutStopSec=90
    $|MemoryMax=100G
    $|MemorySwapMax=0
    $|Restart=no
    $|
  value
}

///|
/// Deployment relocates an accepted opaque runtime manifest. Capacity remains
/// owned by that runtime; no second context/slot/page policy lives here.
fn relocate_service(accepted : Json, plan : Json, root : String) -> Json raise {
  guard accepted is Object(original) else { fail("accepted service manifest") }
  let fields = original.copy()
  fields["model_root"] = Json(root + "/model")
  fields["kernel_root"] = Json(root)
  fields["executable"] = Json(root + "/glm_service.exe")
  fields["listen_address"] = Json(text(plan, "listen_address"))
  fields["production_ready"] = true
  fields["credential_file"] = "backend.credential"
  for key in ["model_label", "runtime_label", "tokenizer_label"] {
    fields[key] = Json(text(plan, key))
  }
  Json(fields)
}

///|
/// Install only; the paired lifecycle owner starts the peer/coordinator later.
/// Existing checkpoint files receive durable hard links, not byte copies/scans.
async fn main {
  guard @env.args() is [_, config, evidence] else {
    fail("CONFIG NEW_EVIDENCE")
  }
  let plan = @json.parse(@fs.read_file(config).text())
  guard plan is { "ranks": Array([head, peer]), .. } else {
    fail("two ranks required")
  }
  @fs.mkdir(evidence, permission=0o700)
  let secret = if plan is { "credential_source": String(path), .. } {
    @fs.read_file(path).text().trim().to_owned()
  } else {
    let generated = @shell.Cmd("openssl", ["rand", "-hex", "32"]).output()
    generated.check()
    generated.stdout().trim().to_owned()
  }
  @fs.write_file(
    evidence + "/backend.credential",
    secret,
    create_mode=CreateNew,
  )
  @shell.Cmd("chmod", ["600", evidence + "/backend.credential"]).run()
  for ordinal, rank in [head, peer] {
    let root = text(rank, "root")
    let home = text(rank, "home")
    guard root.has_prefix(home + "/.local/share/lunanexa/") &&
      !root.contains("..") &&
      root.all(c => {
        c is ('a'..<='z' | 'A'..<='Z' | '0'..<='9' | '/' | '-' | '_' | '.')
      }) else {
      fail("invalid durable root")
    }
    remote(rank, [
      "mkdir",
      "-p",
      home + "/.local/share/lunanexa",
      home + "/.config/systemd/user",
    ])
    remote(rank, ["mkdir", root])
    remote(rank, [
      "cp",
      "-al",
      "--",
      text(rank, "model_source"),
      root + "/model",
    ])
    remote(rank, ["cp", "-a", "--", text(rank, "nccl_source"), root + "/nccl"])
    let prior = text(rank, "accepted_root")
    for
      file in [
        "glm_service.exe",
        "rank\{ordinal}.cubin",
        "sampling.cubin",
        "SHARDS.sha256",
      ] {
      remote(rank, ["cp", "-n", "--", prior + "/" + file, root + "/" + file])
    }
    let service = relocate_service(
      @json.parse(remote_text(rank, ["cat", prior + "/service.json"])),
      plan,
      root,
    )
    @fs.write_file(
      evidence + "/service-\{ordinal}.json",
      service.stringify(),
      create_mode=CreateNew,
    )
    copy(rank, evidence + "/service-\{ordinal}.json", root + "/service.json")
    if ordinal == 0 {
      copy(rank, evidence + "/backend.credential", root + "/backend.credential")
      remote(rank, ["chmod", "600", root + "/backend.credential"])
    }
    let name = text(rank, "unit")
    guard name == "lunanexa-glm-lunaflux-rank\{ordinal}.service" else {
      fail("unexpected owned unit")
    }
    @fs.write_file(
      evidence + "/" + name,
      unit(root, rank, ordinal),
      create_mode=CreateNew,
    )
    // An upgrade preserves the old release and unit, and only replaces a
    // stopped exact owner. The paired controller still owns starting it.
    if rank is { "previous_root": String(previous), .. } {
      let state = remote_text(rank, [
        "systemctl", "--user", "show", name, "-p", "ActiveState", "--value",
      ]).trim()
      guard state is ("inactive" | "failed") else {
        fail("native owner still active")
      }
      let prior_unit = remote_text(rank, ["systemctl", "--user", "cat", name])
      guard prior_unit.contains("WorkingDirectory=" + previous + "\n") else {
        fail("unexpected prior release")
      }
      @fs.write_file(
        evidence + "/previous-" + name,
        prior_unit,
        create_mode=CreateNew,
      )
    } else {
      remote(rank, ["test", "!", "-e", home + "/.config/systemd/user/" + name])
    }
    copy(rank, evidence + "/" + name, home + "/.config/systemd/user/" + name)
    remote(rank, ["systemctl", "--user", "daemon-reload"])
    println("rank \{ordinal} installed, not started")
  }
}

///|
test "native units preserve coordinator-owned shutdown without acceptance timeout" {
  let value = unit("/srv/native", { "interface": "nic0", "hca": "rdma0" }, 0)
  assert_true(value.contains("KillMode=mixed"))
  assert_true(value.contains("MemoryMax=100G"))
  assert_true(value.contains("MemorySwapMax=0"))
  assert_true(value.contains("Restart=no"))
  assert_false(value.contains("RuntimeMaxSec"))
  assert_eq(quote("a'b"), "'a'\\''b'")
}

///|
test "deployment carries accepted capacity without a second allocation policy" {
  let accepted : Json = {
    "context": 8192,
    "slots": 16,
    "history_pages": 513,
    "admission_lanes": 16,
    "budget_mib": 102400,
    "reserve_mib": 2048,
    "control_address": "peer",
    "rows": 64,
  }
  let plan : Json = {
    "listen_address": "host",
    "model_label": "m",
    "runtime_label": "r",
    "tokenizer_label": "t",
  }
  let relocated = relocate_service(accepted, plan, "/srv/new")
  guard relocated is Object(fields) && accepted is Object(original) else {
    fail("object")
  }
  for
    key in [
      "context", "slots", "history_pages", "admission_lanes", "budget_mib", "reserve_mib",
      "control_address", "rows",
    ] {
    assert_eq(fields[key], original[key])
  }
  assert_eq(fields["production_ready"], true)
  assert_eq(fields["executable"], "/srv/new/glm_service.exe")
  assert_false(original.contains("production_ready"))
}
