///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
async fn output(program : String, args : Array[String]) -> String {
  let r = @shell.Cmd(program, args).output()
  r.check()
  r.stdout()
}

///|
async fn main {
  let evidence = "/Users/kq/Workspace/lunanexa/output/persistent-audit-20261125"
  let write = "/Users/kq/.moonsuite/nas-archive/moonsuite-persistent/mac-kq/20261125"
  let read = "/Volumes/wework/moonsuite-persistent/mac-kq/20261125"
  let lock = @fs.open(
    "/Users/kq/Library/Logs/MoonSuite/build-retention/maintenance.lock",
    mode=ReadWrite,
    create_mode=OpenOrCreate,
    permission=0o600,
  )
  defer lock.close()
  guard lock.try_lock(Exclusive) else { fail("A migration is still running") }
  defer lock.unlock()
  guard @fs.exists(evidence + "/after/services.json") &&
    @fs.exists(evidence + "/moonfish-query-cleanup.json") else {
    fail("Complete service acceptance and MoonFish migration first")
  }
  let working_root = "/Users/kq/Workspace/lunachip/artifacts"
  println(
    "Backing up retained original hardware receipts; originals stay in place",
  )
  let remaining_files = @fs.readdir(working_root)
  if !remaining_files.is_empty() {
    let backup = write + "/lunachip/original-top-level-receipts.zip"
    @shell.Cmd(
      "/usr/bin/zip",
      ["-qry", "-1", backup, "artifacts"],
      cwd="/Users/kq/Workspace/lunachip",
    ).run()
    let temp = @fs.tmpdir(prefix="moon-final-receipt-check-")
    defer @fs.rmdir(temp, recursive=true)
    @shell.Cmd("/usr/bin/unzip", ["-q", backup, "-d", temp]).run()
    @shell.Cmd("diff", ["-qr", working_root, temp + "/artifacts"]).run()
    let receipt_hash = output("shasum", ["-a", "256", backup])
      .split(" ")
      .next()
      .unwrap()
      .to_owned()
    @fs.write_file(
      evidence + "/hardware-original-receipts.json",
      (
        {
          "archive": read + "/lunachip/original-top-level-receipts.zip",
          "sha256": receipt_hash,
          "policy": "Keep original small transport packages, receipts, checksums and scripts in place; durable NAS copy verified completely.",
        } : Json).stringify(),
      permission=0o600,
    )
  }
  let hardware : Array[Json] = []
  let names = @fs.readdir(evidence)
  names.sort()
  let mut removed_kib = 0L
  for name in names {
    if name.has_prefix("hardware-") &&
      name.has_suffix(".json") &&
      name != "hardware-manifest.json" &&
      name != "hardware-original-receipts.json" {
      let record = @json.parse(@fs.read_file(evidence + "/" + name).text())
      guard record
        is {
          "source": String(source),
          "archive": String(archive),
          "sha256": String(hash),
          "allocated_kib": String(kib),
          ..
        } else {
        fail("Bad hardware receipt")
      }
      let removed = !@fs.exists(source)
      if removed {
        removed_kib += @string.parse_int64(kib)
      }
      hardware.push({ "receipt": record, "local_copy_removed": removed })
      guard hash.length() == 64 &&
        @fs.kind(archive, follow_symlink=false) is Regular &&
        @fs.file_size(archive) > 0L else {
        fail("Verified hardware archive missing")
      }
    }
  }
  // Every individual receipt records the successful full NAS extraction,
  // byte comparison and SHA256 performed before its source was removed.
  // Reconcile those records without repeating the complete archive I/O.
  let map = hardware
    .map(row => {
      guard row is { "receipt": record, .. } else { abort("Bad record") }
      record.stringify()
    })
    .join("\n") +
    "\n"
  // Rebuild aggregate logs from individual durable receipts. append=true alone
  // defaults to truncation in this fs API; callers must use OpenOrCreate too.
  @fs.write_file(evidence + "/hardware-removals.jsonl", map, permission=0o600)
  @fs.write_file(write + "/lunachip/migration-map.jsonl", map, permission=0o600)
  let recovery : Json = {
    "archives": hardware,
    "nas_root": read + "/lunachip",
    "source_sha256_inventory": read + "/inventory.json",
  }
  @fs.write_file(
    evidence + "/hardware-manifest.json",
    recovery.stringify(),
    permission=0o600,
  )
  @fs.write_file(
    write + "/lunachip/manifest.json",
    recovery.stringify(),
    permission=0o600,
  )
  @fs.write_file(
    "/Users/kq/Workspace/lunachip/docs/evidence/storage-migration-20261125.json",
    recovery.stringify(indent=2),
    permission=0o600,
  )
  guard @json.parse(
      @fs.read_file(evidence + "/moonfish-query-cleanup.json").text(),
    )
    is Array(query) else {
    fail("Bad query record")
  }
  guard @json.parse(
      @fs.read_file(evidence + "/moonfish-export-actions.json").text(),
    )
    is Array(exports) else {
    fail("Bad export record")
  }
  let mut query_bytes = 0L
  let mut clone_bytes = 0L
  for row in query {
    if row is { "size": String(size), .. } {
      query_bytes += @string.parse_int64(size)
    }
  }
  for row in exports {
    if row is { "size": String(size), .. } {
      clone_bytes += @string.parse_int64(size)
    }
  }
  let disk = output("df", ["-k", "/System/Volumes/Data"])
  let fields = disk.split("\n").to_array()[1]
    .split(" ")
    .filter(v => !v.is_empty())
    .to_array()
  let free = @string.parse_int64(fields[3])
  let remaining = @fs.readdir("/Users/kq/Workspace/lunachip/artifacts")
  let cleanup = @json.parse(
    @fs.read_file(evidence + "/query-cleanup-summary.json").text(),
  )
  guard cleanup
    is {
      "retained_changed_or_hot": Array(retained),
      "referenced_object_ids_kept": reference_count,
      ..
    } else {
    fail("Incomplete query cleanup summary")
  }
  let summary : Json = {
    "hardware_archives_verified": hardware.length(),
    "hardware_local_allocated_kib_removed": Json(removed_kib),
    "remaining_hardware_entries": remaining,
    "cold_unreferenced_query_local_copies_removed": query.length(),
    "cold_unreferenced_query_logical_bytes": Json(query_bytes),
    "query_cleanup": {
      "retained_changed_or_hot_files": retained.length(),
      "referenced_object_ids_kept": reference_count,
      "local_manifest": evidence + "/moonfish-query-cleanup.json",
      "all_64_materialized_snapshots_kept_locally": true,
    },
    "registered_exports_compacted_with_apfs_clones": exports.length(),
    "clone_logical_bytes": Json(clone_bytes),
    "duplicate_groups": 15715,
    "duplicate_extra_logical_bytes": "20076370052",
    "available_kib": Json(free),
    "available_gib": free.to_double() / 1048576.0,
    "nas_root": read,
    "persistent_data": "Saved exports, query/source snapshots and experiment evidence. Complete verified point-in-time copies are on NAS. All referenced query objects, all materialized snapshots, changed/hot data, mutable state and registered export working files remain local. Only old unreferenced query objects were removed locally; no live NAS symlinks introduced.",
    "protected": "No Codex history/tools, model weights, installed current/two rollback versions, running services, VM, .191 or cluster resources were removed or reconfigured.",
    "acceptance": @json.parse(
      @fs.read_file(evidence + "/after/services.json").text(),
    ),
    "note": "Allocated/logical removal totals differ from net physical recovery under APFS, sparse files and concurrent builds. New application output needs a future explicit persistence pass; daily build-only retention is unchanged.",
  }
  @fs.write_file(
    evidence + "/summary.json",
    summary.stringify(indent=2),
    permission=0o600,
  )
  @fs.write_file(
    write + "/summary.json",
    summary.stringify(indent=2),
    permission=0o600,
  )
  @fs.write_file(
    write + "/README.txt",
    "Manual persistent-data migration, 2026-11-25.\n\nHardware: lunachip/manifest.json records exact original paths, archives and SHA256. Restore ZIP archives with /usr/bin/unzip into a chosen parent; the first feedback archive is tar.gz and uses tar -xpf. Every archive was fully extracted and compared before local removal. Mac metadata hex and permission/flag listings are retained separately. Small original receipts/scripts remain local and are backed up in original-top-level-receipts.zip. Do not compile inside restored sealed evidence.\n\nMoonFish: complete exports and research artifacts are ZIP archives, with state recovery copies. Registered export paths still work locally; old identical files share APFS extents, not inodes. query-normalized.zip, query-raw.zip and query-snapshots.zip contain the complete original stores under query/objects/<kind> and query/snapshots; each was completely restored and byte-compared. moonfish-query-cleanup.json records every removed cold unreferenced local object and its archive member. Referenced objects, all materialized snapshots, changed/recent data and mutable metadata remain local. No live NAS symlinks were introduced. query-metadata-recovery.zip is an additional capture, not a stopped-service transactional backup. Any moonfish/query plaintext directory is an abandoned partial transfer, not the authoritative complete copy.\n\nTo recover an individual query object: unzip -p query-raw.zip query/objects/raw/ID.json (or normalized equivalent); compare its SHA256 with the cleanup manifest before restoring its original path.\n\nNew output requires a future explicit persistence pass. No new state-deletion automation. Models, Codex history, running services, build VM, .191 and cluster were untouched.\n",
    permission=0o600,
  )
  let failed = write + "/lunachip/prx100-layer-stripe-20261020.tar.gz.partial"
  if @fs.exists(failed) &&
    @fs.exists(read + "/lunachip/prx100-layer-stripe-20261020.zip") {
    @fs.remove(failed)
  }
  println("Copying complete audit/acceptance evidence to NAS")
  @shell.Cmd("rsync", ["-rt", evidence + "/", write + "/audit-evidence/"]).run()
  println(summary.stringify(indent=2))
}
