  let seen : Map[String, Bool] = Map([])
  for key in keys {
    let english = enterprise_copy(English, key)
    let chinese = enterprise_copy(ChineseSimplified, key)
    assert_true(english.trim() != "")
    assert_true(chinese.trim() != "")
    let pair = english + "\n" + chinese
    assert_false(seen.contains(pair))
    seen[pair] = true
  }
  assert_eq(keys.length(), 478)
