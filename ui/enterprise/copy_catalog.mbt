///|
fn enterprise_copy(
  locale : @i18n.Locale,
  key : EnterpriseCopyMessage,
) -> String {
  match key {
    SelectAnActiveOrganizationBeforeContinuing =>
      @i18n.copy(
        locale, "Select an active organization before continuing.", "请先选择一个活跃组织。",
      )
    Overview => @i18n.copy(locale, "Overview", "概览")
    GetStarted => @i18n.copy(locale, "Get started", "自助开通")
    AccountApiKeys =>
      @i18n.copy(locale, "Account & API keys", "账户与 API 密钥")
    Agreements => @i18n.copy(locale, "Agreements", "协议")
    ManagedRequests => @i18n.copy(locale, "Managed requests", "受管申请")
    Notifications => @i18n.copy(locale, "Notifications", "通知")
    UsageCosts => @i18n.copy(locale, "Usage & costs", "用量与成本")
    ModelCatalog => @i18n.copy(locale, "Model catalog", "模型目录")
    Webide => @i18n.copy(locale, "WebIDE", "WebIDE")
    MyMachine => @i18n.copy(locale, "My machine", "我的机器")
    OrdersDocuments =>
      @i18n.copy(locale, "Orders & documents", "订单与材料")
    ContractForms => @i18n.copy(locale, "Contract forms", "合同表单")
    ReviewRequired => @i18n.copy(locale, "Review required", "待审阅")
    SignatureInProgress =>
      @i18n.copy(locale, "Signature in progress", "签署中")
    Executed => @i18n.copy(locale, "Executed", "已签署")
    Declined => @i18n.copy(locale, "Declined", "已拒绝")
    Superseded => @i18n.copy(locale, "Superseded", "已替代")
    PreparingSecureLink =>
      @i18n.copy(locale, "Preparing secure link", "正在准备安全链接")
    ReadyToContinue =>
      @i18n.copy(locale, "Ready to continue", "可继续办理")
    Verified => @i18n.copy(locale, "Verified", "已验证")
    Authorized => @i18n.copy(locale, "Authorized", "已授权")
    Paid => @i18n.copy(locale, "Paid", "已支付")
    Issued => @i18n.copy(locale, "Issued", "已开具")
    Failed => @i18n.copy(locale, "Failed", "失败")
    Expired => @i18n.copy(locale, "Expired", "已过期")
    Voided => @i18n.copy(locale, "Voided", "已作废")
    Credited => @i18n.copy(locale, "Credited", "已贷记")
    Refunded => @i18n.copy(locale, "Refunded", "已退款")
    AwaitingOperator =>
      @i18n.copy(locale, "Awaiting operator", "等待运维审核")
    NodeReserved => @i18n.copy(locale, "Node reserved", "节点已预留")
    Rejected => @i18n.copy(locale, "Rejected", "已拒绝")
    Cancelled => @i18n.copy(locale, "Cancelled", "已取消")
    Enterprise => @i18n.copy(locale, "Enterprise", "企业平台")
    EnterpriseNavigation =>
      @i18n.copy(locale, "Enterprise navigation", "企业导航")
    CustomerBoundary => @i18n.copy(locale, "Customer boundary", "客户边界")
    CatalogOrdersAreSelfServiceManaged =>
      @i18n.copy(
        locale, "Catalog orders are self-service. Managed requests remain available when an operator must select exceptional capacity.",
        "目录订单支持自助开通；需要运维人员选择特殊算力时，仍可提交受管申请。",
      )
    SelectOrganization =>
      @i18n.copy(locale, "Select organization", "选择组织")
    EnterpriseControlCenter =>
      @i18n.copy(locale, "ENTERPRISE CONTROL CENTER", "企业控制中心")
    Language => @i18n.copy(locale, "Language", "语言")
    InterfaceLanguage =>
      @i18n.copy(locale, "Interface language", "界面语言")
    Organization => @i18n.copy(locale, "Organization", "组织")
    ActiveOrganizationForScopedRequests =>
      @i18n.copy(
        locale, "Active organization for scoped requests", "限定范围请求所使用的活跃组织",
      )
    TenantScoped => @i18n.copy(locale, "Tenant scoped", "限定租户范围")
    FreeSharedInferenceTrial =>
      @i18n.copy(
        locale, "FREE SHARED-INFERENCE TRIAL", "免费共享推理体验",
      )
    YourTrialIsReady =>
      @i18n.copy(locale, "Your trial is ready", "您的体验已就绪")
    YourTrialHasEnded =>
      @i18n.copy(locale, "Your trial has ended", "您的体验已结束")
    UseTheApprovedModelThroughA =>
      @i18n.copy(
        locale, "Use the approved model through a quota-bound API key. This trial never grants SSH or exclusive machine access.",
        "通过受额度约束的 API 密钥使用已批准模型。体验不会授予 SSH 或独占机器权限。",
      )
    YourAccountRemainsActiveAskYour =>
      @i18n.copy(
        locale, "Your account remains active. Ask your organization for an invitation to continue with governed enterprise access.",
        "您的账户仍然有效。如需继续，请向组织申请邀请并升级为受治理的企业访问。",
      )
    Requests => @i18n.copy(locale, "Requests", "请求数")
    TryAPromptInTheWorkbench =>
      @i18n.copy(
        locale, "Try a prompt in the workbench", "先在工作台试一句",
      )
    CreateTrialApiKey =>
      @i18n.copy(locale, "Create trial API key", "创建体验 API 密钥")
    ViewTrialApiKey =>
      @i18n.copy(locale, "View trial API key", "查看体验 API 密钥")
    YourLunanexaTenant =>
      @i18n.copy(locale, "YOUR PLATFORM TENANT", "您的平台租户")
    NeedAManagedCapacityException =>
      @i18n.copy(
        locale, "Need a managed capacity exception?", "需要受管算力例外？",
      )
    UseThisPathWhenTheSelf =>
      @i18n.copy(
        locale, "Use this path when the self-service catalog cannot satisfy your requirements. An operator will review policy, availability and node assignment.",
        "当自助目录无法满足需求时使用此流程。运维人员将审核策略、库存与节点分配。",
      )
    RequestManagedCapacity =>
      @i18n.copy(locale, "Request managed capacity", "申请受管算力")
    AgreementsToReview =>
      @i18n.copy(locale, "Agreements to review", "待审阅协议")
    LegalSignerAction =>
      @i18n.copy(locale, "Legal signer action", "需要法定签署人操作")
    OpenLeaseRequests =>
      @i18n.copy(locale, "Open lease requests", "待处理租用申请")
    OperatorReviewQueue =>
      @i18n.copy(locale, "Operator review queue", "运维审核队列")
    ModelsEntitled => @i18n.copy(locale, "Catalog models", "目录模型")
    SharedCentralCatalog =>
      @i18n.copy(locale, "Shared central catalog", "中央共享目录")
    CurrentSpend => @i18n.copy(locale, "Current spend", "当前支出")
    ProvisionalCentralLedger =>
      @i18n.copy(locale, "Provisional central ledger", "中央台账暂计")
    OrganizationAdministrator =>
      @i18n.copy(locale, "Organization administrator", "组织管理员")
    LegalSigner => @i18n.copy(locale, "Legal signer", "法定签署人")
    LeaseRequester => @i18n.copy(locale, "Lease requester", "租用申请人")
    BillingViewer => @i18n.copy(locale, "Billing viewer", "账单查看者")
    Developer => @i18n.copy(locale, "Developer", "开发者")
    PlatformOperator =>
      @i18n.copy(locale, "Platform operator", "平台运维人员")
    AuditReader => @i18n.copy(locale, "Audit reader", "审计查看者")
    EnterpriseUser => @i18n.copy(locale, "Enterprise user", "企业用户")
    Invited => @i18n.copy(locale, "Invited", "已邀请")
    Active => @i18n.copy(locale, "Active", "有效")
    Suspended => @i18n.copy(locale, "Suspended", "已暂停")
    Revoked => @i18n.copy(locale, "Revoked", "已撤销")
    ModelList => @i18n.copy(locale, "Model list", "模型列表")
    Inference => @i18n.copy(locale, "Inference", "推理")
    QuotaExhausted => @i18n.copy(locale, "Quota exhausted", "配额已用尽")
    CreateApiKey => @i18n.copy(locale, "Create API key", "创建 API 密钥")
    TheSecretIsShownOnceTrial =>
      @i18n.copy(
        locale, "The secret is shown once. Trial keys follow trial limits; other keys require the deployment's active authorization and Developer role.",
        "密钥仅显示一次。体验密钥遵守体验限制；其他密钥要求部署策略规定的有效授权与开发者角色。",
      )
    BillingProject => @i18n.copy(locale, "Billing project", "计费项目")
    KeyName => @i18n.copy(locale, "Key name", "密钥名称")
    Scopes => @i18n.copy(locale, "Scopes", "权限范围")
    AllowedModels => @i18n.copy(locale, "Allowed models", "允许的模型")
    OptionalCommaSeparatedAliases =>
      @i18n.copy(
        locale, "Optional, comma-separated aliases", "可选，使用英文逗号分隔别名",
      )
    LeaveEmptyToAllowEveryModel =>
      @i18n.copy(
        locale, "Leave empty to allow every model granted by the account contract.",
        "留空表示允许账户合同授予的所有模型。",
      )
    Lifetime => @i18n.copy(locale, "Lifetime", "有效期")
    Day => @i18n.copy(locale, "1 day", "1 天")
