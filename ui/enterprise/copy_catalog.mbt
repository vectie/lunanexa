    Verified => @i18n.copy(locale, "Verified", "已验证")
    Authorized => @i18n.copy(locale, "Authorized", "已授权")
    Paid => @i18n.copy(locale, "Paid", "已支付")
    Issued => @i18n.copy(locale, "Issued", "已开具")
