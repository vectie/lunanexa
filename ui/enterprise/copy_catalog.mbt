      @i18n.copy(
        locale, "The platform stores only its hash. This secret cannot be retrieved after you close this dialog.",
        "平台仅存储其哈希值。关闭此对话框后将无法再次获取该密钥。",
      )
    Name => @i18n.copy(locale, "Name", "名称")
