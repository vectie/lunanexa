        locale, "The daily machine price is CNY 49, billed in whole days. Undertaking orders retain their published weekly and monthly tiers and operator approval.",
        "机器日租统一为 ¥49，按整天计费；承诺函订单的周／月档位和管理侧审批保持不变。",
      )
    ThisAccountLacksPermissionForThis =>
      @i18n.copy(
        locale, "This account lacks permission for this action. Check the selected organization and ask its administrator.",
        "当前账户无此操作权限，请核对所选组织并联系该组织管理员。",
      )
    YourSessionOrCredentialIsInvalid =>
      @i18n.copy(
        locale, "Your session or credential is invalid. Sign in again and check the API entrance.",
        "会话或凭据无效，请重新登录并核对 API 入口。",
      )
    TheResourceChangedRefreshItsStatus =>
      @i18n.copy(
        locale, "The resource changed. Refresh its status before retrying.", "资源状态已变化，请刷新状态后再重试。",
      )
    TheQuotaOrRateLimitWas =>
      @i18n.copy(
        locale, "The quota or rate limit was reached. Check Usage & costs and wait before retrying.",
        "已达到额度或速率限制，请查看用量与费用，稍后再试。",
      )
    TheConnectionDidNotCompleteCheck =>
      @i18n.copy(
        locale, "The connection did not complete. Check your network and refresh status before retrying; the action may already have completed.",
        "连接未完成，请检查网络并刷新状态后再试；操作可能已完成。",
      )
    TheActionFailedRefreshAndRetry =>
      @i18n.copy(
        locale, "The action failed. Refresh and retry; if it persists, contact your operator with the action and time. Sensitive technical details are hidden.",
        "操作失败，请刷新后重试；若持续失败，请向运维提供操作名称和时间。敏感技术详情已隐藏。",
      )
    CurrentTimeUnavailable =>
      @i18n.copy(locale, "Current time unavailable", "当前时间不可用")
    HRemaining => @i18n.copy(locale, "h remaining", " 小时后到期")
    MRemaining => @i18n.copy(locale, "m remaining", " 分钟后到期")
    CopyIdentifier => @i18n.copy(locale, "Copy identifier", "复制标识符")
    Copy => @i18n.copy(locale, "Copy", "复制")
    RequestQuotaUsed =>
      @i18n.copy(locale, "Request quota used", "已使用请求配额")
    ViewErrorGuide =>
      @i18n.copy(locale, "View error guide", "查看错误说明")
    HowToUseThisPage =>
      @i18n.copy(
        locale, "How to use this page", "这一页怎么用，看教程",
      )
  }
