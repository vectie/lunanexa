///|
/// Shared spatial rhythm for the deployed customer and operator surfaces.
fn layout_styles() -> String {
  (
    #|.console-root,.enterprise-root{--ln-gutter:2rem;--ln-gap:1rem;--ln-radius:.75rem}
    #|.console-root :is(.table-scroll,.resource-table-wrap),.enterprise-root .table-scroll{max-width:100%;overflow-x:auto;overscroll-behavior-inline:contain}.console-root summary,.enterprise-root summary{min-height:44px;cursor:pointer}.console-root :is(summary,button,a,input,select,textarea,[tabindex]):focus-visible,.enterprise-root :is(summary,button,a,input,select,textarea,[tabindex]):focus-visible{outline:2px solid var(--accent,var(--mint));outline-offset:3px}.console-root .modal-backdrop,.enterprise-root .modal-backdrop{overflow-y:auto;align-items:safe center}.console-root .confirmation-dialog,.enterprise-root .confirmation-dialog{max-height:calc(100dvh - 2rem);overflow-y:auto}.console-root :is(pre,code),.enterprise-root :is(pre,code){overflow-wrap:anywhere}.console-root .table-scroll:focus-visible,.enterprise-root .table-scroll:focus-visible{outline-offset:-2px}
    #|.console-root .pool-running-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,12rem),1fr));gap:.75rem}.console-root .pool-running-row{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.8rem;border:1px solid var(--line);border-radius:.5rem;background:var(--surface)}.console-root .pool-running-row span{color:var(--muted)}.console-root .pool-deployment-settings>summary{min-height:44px;padding:.7rem 0;cursor:pointer;font-weight:650}.console-root .pool-deployment-settings>summary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.console-root .model-pool-panel>h3{margin:0}.console-root .model-pool-panel>.ln-advanced{margin:0}
    #|.console-root .model-registry-groups{display:grid;gap:.75rem;margin-top:1rem}.console-root .model-family{border:1px solid var(--line);border-radius:.65rem;background:var(--surface);overflow:hidden}.console-root .model-family>summary{min-height:56px;padding:1rem;cursor:pointer}.console-root .model-family>summary strong{margin-right:.65rem}.console-root .model-registry-group{margin:.25rem 1rem .75rem}.console-root .model-registry-group>summary{min-height:44px;padding:.7rem 0;cursor:pointer;font-weight:650}.console-root .model-registry-group .resource-table td{vertical-align:top}.console-root .model-more-actions>summary,.console-root .model-registry-group td summary{min-height:44px;padding:.6rem .25rem;cursor:pointer;white-space:nowrap}.console-root .model-more-actions .row-actions{display:grid;gap:.5rem;min-width:9rem;padding:.5rem 0}.console-root .model-onboarding-panel>summary{min-height:44px;cursor:pointer;font-weight:650}.console-root .model-onboarding-panel[open]>summary{margin-bottom:1rem}.console-root .model-onboarding-panel .model-source-search{margin-top:0}.console-root :is(.model-family,.model-registry-group,.model-more-actions)>summary:focus-visible{outline:2px solid var(--accent);outline-offset:-3px}
    #|.console-root :is(.model-adoption-form,.model-onboarding-form) .field-help:not(.field-error),.console-root .model-adoption-intro{display:none}
    #|.console-root .manual-access>summary{cursor:pointer;min-height:44px;padding:.7rem 0}.console-root .manual-access>summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.console-root .portal-node-picker select{width:100%;min-height:44px;padding:.55rem .65rem;border:1px solid var(--line-strong);border-radius:.45rem;background:var(--panel-strong);color:var(--text);font:inherit}
    #|.console-root :is(.template-settings,.deployment-process,.model-onboarding-process)>summary{cursor:pointer;min-height:44px;padding:.7rem 0;line-height:1.5}.console-root :is(.template-settings,.deployment-process,.model-onboarding-process)>summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.console-root .template-settings{margin:.5rem 0;border-top:1px solid var(--line)}
    #|.enterprise-root :is(.trial-api-settings,.account-permissions,.checkout-panel,.provider-history)>summary{cursor:pointer;min-height:44px;padding:.7rem 0;line-height:1.5}.enterprise-root :is(.trial-api-settings,.account-permissions,.checkout-panel,.provider-history)>summary:focus-visible{outline:2px solid var(--mint);outline-offset:3px}.enterprise-root .trial-api-settings{margin-top:1rem}.enterprise-root .trial-panel .primary-action{width:auto;min-height:44px;padding:.65rem 1rem}
    #|.navigation-group{grid-column:1/-1;width:100%;margin:.35rem 0}.navigation-group>summary{min-height:44px;padding:.75rem .8rem;color:var(--muted);font-size:.85rem;cursor:pointer;list-style:revert}.navigation-group>summary:focus-visible{outline:2px solid var(--accent,var(--mint));outline-offset:2px}.navigation-group>div{display:grid;gap:.2rem;padding-left:.65rem}.navigation-group>div>button{width:100%;text-align:left}.navigation-group[open]>summary{color:var(--ink);font-weight:650}
    #|.console-root .mobile-nav-toggle,.enterprise-root .mobile-nav-toggle{display:none}
    #|@media(max-width:52rem){.console-root .sidebar,.enterprise-root .enterprise-sidebar{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:.5rem;padding:.75rem 1rem}.console-root .sidebar .brand,.enterprise-root .enterprise-brand{margin:0;padding:0;border:0}.console-root .mobile-nav-toggle,.enterprise-root .mobile-nav-toggle{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:.5rem .75rem}.console-root .sidebar>nav,.enterprise-root .enterprise-sidebar>nav{grid-column:1 / -1;margin-top:.5rem}.console-root .sidebar:not(.is-open)>nav,.enterprise-root .enterprise-sidebar:not(.is-open)>nav,.enterprise-root .enterprise-sidebar:not(.is-open)>a.nav-link{display:none}.enterprise-root .enterprise-sidebar>a.nav-link{grid-column:1 / -1}}
    #|.console-root .workspace-topbar,.enterprise-root .enterprise-topbar{min-height:5rem;padding:1rem var(--ln-gutter);align-items:center;gap:1rem}
    #|.console-root .page-heading h1,.enterprise-root .enterprise-topbar h1{font-size:1.5rem;line-height:1.35;letter-spacing:-.02em}
    #|.console-root .workspace-main,.enterprise-root .enterprise-content{padding:1.5rem var(--ln-gutter) 2rem}
    #|.console-root :is(.section-heading,.subsection-heading),.enterprise-root .section-heading{align-items:center;gap:1rem;flex-wrap:wrap}
    #|.console-root :is(h2,h3,h4),.enterprise-root :is(h2,h3,h4){text-wrap:balance;overflow-wrap:anywhere}
    #|.enterprise-root :is(.welcome-panel,.workflow-panel,.request-form,.request-history,.data-table-panel,.service-entry,.guided-panel){padding:1.25rem;border-radius:var(--ln-radius)}
    #|.enterprise-root .welcome-panel h2{font-size:1.25rem;line-height:1.4;margin:0 0 .5rem}
    #|.enterprise-root .page-stack{gap:1.5rem}.enterprise-root .metric{min-height:6.5rem}.enterprise-root .metric strong{font-variant-numeric:tabular-nums}
    #|.enterprise-root .service-choice-grid{grid-template-columns:repeat(auto-fit,minmax(min(100%,15rem),1fr));gap:1rem}
    #|.enterprise-root .service-choice{gap:.5rem}.enterprise-root .service-choice h3{margin:0 0 .5rem;font-size:1rem;line-height:1.5}.enterprise-root .service-choice>button:first-of-type{margin-top:auto}
    #|.enterprise-root .shared-trial-panel{display:block}.enterprise-root .shared-trial-panel>div{width:100%}.enterprise-root .shared-trial-card{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.35rem 1rem;align-items:center;margin-top:1rem}
    #|.enterprise-root .shared-trial-card h3{margin:0;font-size:1rem;line-height:1.5}.enterprise-root .shared-trial-card p{grid-column:1;margin:0!important;font-size:.8rem}.enterprise-root .shared-trial-card :is(button,a){grid-column:2;grid-row:1 / span 2;min-width:10rem;max-width:14rem;text-align:center;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}
    #|.enterprise-root .model-api-card{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start}.enterprise-root .model-api-card .record-main{width:100%}.enterprise-root .model-api-card .record-actions{max-width:12rem;width:12rem}
    #|.enterprise-root .connection-value{display:grid;grid-template-columns:minmax(0,1fr) 44px;align-items:center;gap:.75rem;min-width:0}.enterprise-root .connection-value p{min-width:0;margin:.5rem 0;overflow-wrap:anywhere}
    #|.enterprise-root .model-api-card h3{margin:0;font-size:1rem}.enterprise-root .model-api-card .record-actions button{width:100%}
    #|.enterprise-root .api-key-card{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.75rem 1rem;align-content:start}.enterprise-root .api-key-card-heading{grid-column:1 / -1;align-items:center}.enterprise-root .api-key-card-heading h3{margin:0;font-size:1rem}
    #|.enterprise-root .api-key-card{grid-template-rows:minmax(3rem,auto) auto auto 1fr auto}.enterprise-root .api-key-card-heading .state-pill{white-space:nowrap;flex:none}.enterprise-root .api-key-card>:not(.api-key-actions){grid-column:1 / -1}.enterprise-root .api-key-card>.api-key-actions{grid-column:1 / -1;justify-self:end;align-self:end;margin:0}.enterprise-root .api-key-card>.api-key-facts{grid-column:1 / -1;display:grid;grid-template-columns:1fr;min-width:0;margin:0}.enterprise-root .api-key-facts>div{padding:0;border:0;background:none}.enterprise-root .api-key-card>.ln-advanced{margin:0}.enterprise-root .account-facts dd{overflow-wrap:anywhere;font-variant-numeric:tabular-nums}
    #|.console-root .readiness-panel{grid-template-columns:1fr;gap:.75rem}.console-root .readiness-copy{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}.console-root .readiness-copy h2{margin:0}.console-root .readiness-action{margin:0}
    #|.console-root input[type=checkbox],.enterprise-root input[type=checkbox]{width:1.125rem;height:1.125rem;min-height:0;flex:none;accent-color:var(--accent,var(--mint));margin:0}
    #|.console-root label:has(>input[type=checkbox]),.enterprise-root label:has(>input[type=checkbox]){display:inline-flex;align-items:center;gap:.625rem;min-height:44px;cursor:pointer}
    #|.console-root .form-actions,.enterprise-root :is(.form-actions,.dialog-actions,.api-key-actions){align-items:center;gap:.5rem;flex-wrap:wrap}
    #|.console-root .nav-indicator{visibility:hidden}.console-root .nav-link.active .nav-indicator{visibility:visible}
    #|.console-root .overview-grid{grid-template-columns:minmax(0,1fr) auto;align-items:stretch}.console-root .health-panel{display:grid;align-content:center;min-height:6rem;padding:1.25rem}.console-root .health-title h2{font-size:1.125rem}
    #|.console-root .activity-panel{display:flex;align-items:center;gap:1rem;padding:1.25rem}.console-root .activity-panel p{margin:0}.console-root .activity-value{font-size:1.25rem;font-variant-numeric:tabular-nums}
    #|.console-root .stat{min-height:6rem}.console-root .stat dd,.console-root .fleet-node-facts dd{font-variant-numeric:tabular-nums}.console-root .fleet-node{display:flex;flex-direction:column}.console-root .fleet-node-actions{margin-top:auto;padding-top:.75rem}.console-root .fleet-node>details{margin-bottom:.75rem}
    #|.console-root .model-pool-panel{display:grid;gap:1rem}.console-root .model-pool-panel>p{margin:0}.console-root .model-pool-panel .model-pool-grid{align-items:stretch;gap:1rem}.console-root .model-pool-panel .access-package-card{display:flex;flex-direction:column;gap:.5rem;min-width:0}.console-root .model-pool-panel .access-package-card>:is(h3,p){margin:0}.console-root .pool-replica-heading{display:flex;align-items:center;justify-content:space-between;gap:.75rem}.console-root .pool-replica-heading h3{margin:0}.console-root .pool-replica-state{font-weight:650}.console-root .model-pool-panel .field-group{margin:0}.console-root .model-pool-panel .access-package-card>.ln-advanced{margin-top:auto}
    #|.console-root .model-pool-panel .pool-replica.is-selected{border-color:var(--success)}.console-root .pool-replica-heading p{margin:0}.console-root .model-pool-panel>button{justify-self:start}
    #|.ln-advanced{border-top:0!important}.ln-advanced>summary{display:list-item;padding:.65rem 0;line-height:1.5}.ln-advanced[open]>.ln-advanced-content{border-top:1px solid var(--line,currentColor);padding-top:1rem}.ln-advanced-content>:first-child{margin-top:0}
    #|.enterprise-root select:not(#enterprise-locale):not(#enterprise-organization){max-width:100%;min-height:44px;padding:.6rem .75rem;border:1px solid var(--line);border-radius:.5rem;background:var(--panel);color:var(--ink);font:inherit}
    #|@media(max-width:68rem){.console-root,.enterprise-root{--ln-gutter:1.5rem}.enterprise-root .model-api-card{grid-template-columns:1fr}.enterprise-root .model-api-card .record-actions{display:flex;flex-flow:row wrap;max-width:none;width:100%;align-items:center}.enterprise-root .model-api-card .record-actions button{width:auto;flex:1 1 9rem}}
    #|@media(max-width:52rem){.console-root,.enterprise-root{--ln-gutter:1rem}.console-root .workspace-topbar,.enterprise-root .enterprise-topbar{min-height:4.5rem;align-items:center;flex-wrap:wrap}.console-root .workspace-topbar .topbar-actions,.enterprise-root .topbar-actions{width:auto;flex-direction:row;align-items:center}.console-root .overview-grid{grid-template-columns:1fr}.console-root .stats{grid-template-columns:repeat(2,minmax(0,1fr))}.enterprise-root .shared-trial-card{grid-template-columns:1fr}.enterprise-root .shared-trial-card :is(button,a){grid-column:1;grid-row:auto;max-width:none;width:100%;margin-top:.5rem}.enterprise-root .api-key-card{grid-template-columns:1fr}.enterprise-root .api-key-card>.api-key-actions,.enterprise-root .api-key-card>.api-key-facts{grid-column:1}.console-root :is(input,select,textarea),.enterprise-root :is(input,select,textarea){font-size:1rem}}
  )
}
