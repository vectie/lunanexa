import {
  "vectie/lunanexa/database",
  "vectie/lunanexa/deployment/store" @deployment_store,
  "vectie/lunanexa/node",
  "vectie/lunanexa/registry",
  "vectie/lunanexa/scheduler",
  "vectie/lunanexa/store",
  "vectie/lunanexa/telemetry",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: {
    "native": { "cc-link-flags": "-L/opt/homebrew/lib/postgresql@17 -lpq" },
  },
)
