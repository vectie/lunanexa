import {
  "vectie/lunanexa/account",
  "vectie/lunanexa/access",
  "vectie/lunanexa/commercial",
  "vectie/lunanexa/commercial/integrations" @commercial_integrations,
  "vectie/lunanexa/commercial/offline",
  "vectie/lunanexa/commercial/offline/store" @offline_store,
  "vectie/lunanexa/contractdoc/store" @contractdoc_store,
  "vectie/lunanexa/contracts",
  "vectie/lunanexa/contractdoc",
  "vectie/lunanexa/api",
  "vectie/lunanexa/database",
  "vectie/lunanexa/deployment/store" @deployment_store,
  "vectie/lunanexa/guide_monitor/probe" @guide_probe,
  "vectie/lunanexa/runtimes",
  "vectie/lunanexa/registry",
  "vectie/lunanexa/node",
  "vectie/lunanexa/nodelease/store" @nodelease_store,
  "vectie/lunanexa/nodelease",
  "vectie/lunanexa/nodelease/credential/store" @credential_store,
  "vectie/lunanexa/notifications/store" @notification_store,
  "vectie/lunanexa/notifications/worker" @notification_worker,
  "vectie/lunanexa/observability",
  "vectie/lunanexa/onboarding",
  "vectie/lunanexa/portal/store" @portal_store,
  "vectie/lunanexa/store",
  "vectie/lunanexa/scheduler",
  "vectie/lunanexa/settings",
  "vectie/lunanexa/telemetry",
  "vectie/lunanexa/technical/store" @technical_store,
  "vectie/lunanexa/workspace/directory",
  "vectie/lunanexa/workspace/client_handoff",
  "vectie/lunanexa/workspace/client_handoff/store" @client_handoff_store,
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/http",
  "moonbitlang/async/socket",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x/crypto",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: {
    "native": { "cc-link-flags": "-L/opt/homebrew/lib/postgresql@17 -lpq" },
  },
)
