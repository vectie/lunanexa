import {
  "vectie/lunanexa/contracts",
  "vectie/lunanexa/database",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/crypto",
}

supported_targets = "native"

import {
  "moonbitlang/core/env",
} for "test"

options(
  link: {
    "native": { "cc-link-flags": "-L/opt/homebrew/lib/postgresql@17 -lpq" },
  },
)
