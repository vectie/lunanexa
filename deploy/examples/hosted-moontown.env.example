# Copy to ignored deploy/local/, replace placeholders and source before envsubst.
# No credentials or site-specific values belong in this example.
export NAMESPACE=platform
export CONTROLLER_NAMESPACE=platform
export MOONGATE_NAMESPACE=platform
export PUBLIC_HOST=platform.example
export PUBLIC_ORIGIN=https://platform.example
export PUBLIC_TLS_SECRET=platform-public-tls
export CONTROLLER_ORIGIN=https://controller.platform.svc.cluster.local:5888
export MOONGATE_ORIGIN=https://moongate.platform.svc.cluster.local:5883
export CONTROLLER_PORT=5888
export MOONGATE_PORT=5883
export STORAGE_CLASS=workspace-rwx
export STORAGE_ACCESS_MODE=ReadWriteMany
export TRUST_CONFIG_MAP=platform-trust-ca
export WEBIDE_SERVICE_ACCOUNT=webide-gateway
export WORKSPACE_NODE_LABEL_KEY=node-role.kubernetes.io/workspace
export WORKSPACE_NODE_LABEL_VALUE=true
export INGRESS_NAMESPACE=ingress-system
export INGRESS_POD_LABEL_KEY=app.kubernetes.io/name
export INGRESS_POD_LABEL_VALUE=traefik
export COMFY_IMAGE=registry.example/comfyui@sha256:REPLACE_WITH_PINNED_DIGEST
export MODEL_PROXY_IMAGE=registry.example/model-proxy@sha256:REPLACE_WITH_PINNED_DIGEST
export MOONTOWN_IMAGE=registry.example/moontown@sha256:REPLACE_WITH_PINNED_DIGEST
export MOONCLAW_MOONGATE_IMAGE=registry.example/moonclaw-moongate@sha256:REPLACE_WITH_PINNED_DIGEST
export WEBIDE_GATEWAY_IMAGE=registry.example/webide-gateway@sha256:REPLACE_WITH_PINNED_DIGEST
