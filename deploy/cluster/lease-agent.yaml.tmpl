# Optional, per-node exclusive-lease adapter. Apply only after installing and
# physically verifying the root-owned host helper and receipt key on NODE_ID.
# The ordinary managed-runtime node agent remains unchanged and lease-disabled.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: lunanexa-lease-agent-${NODE_ID}
  namespace: ${NAMESPACE}
  labels:
    app: lunanexa-lease-agent
    app.kubernetes.io/part-of: lunanexa
    lunanexa.io/plane: node-agent
    lunanexa.io/node: ${NODE_ID}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: lunanexa-lease-agent
      lunanexa.io/node: ${NODE_ID}
  template:
    metadata:
      labels:
        app: lunanexa-lease-agent
        app.kubernetes.io/part-of: lunanexa
        lunanexa.io/plane: node-agent
        lunanexa.io/node: ${NODE_ID}
    spec:
      automountServiceAccountToken: false
      hostPID: true
      nodeSelector:
        kubernetes.io/hostname: ${NODE_ID}
      serviceAccountName: lunanexa-node
      tolerations:
        - effect: NoSchedule
          key: lunanexa.io/role
          operator: Equal
          value: gpu
      containers:
        - name: lease-agent
          image: ${NODE_IMAGE}
          imagePullPolicy: IfNotPresent
          command: [/usr/local/bin/lunanexa-node]
          args: [--lease-only]
          securityContext:
            privileged: true
            readOnlyRootFilesystem: true
            runAsUser: 0
            runAsGroup: 0
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              cpu: 250m
              memory: 128Mi
          env:
            - name: LUNANEXA_ADMIN_SETTINGS_PATH
              value: /etc/lunanexa/admin-policy/admin-settings.json
            - name: LUNANEXA_ENDPOINT
              value: http://127.0.0.1:18080
            - name: LUNANEXA_NODE_ID
              value: ${NODE_ID}
            - name: LUNANEXA_NODE_TOKEN_PATH
              value: /etc/lunanexa/credentials/node-token
            - name: LUNANEXA_EXCLUSIVE_LEASES_ENABLED
              value: "1"
            - name: LUNANEXA_LEASE_STATE_PATH
              value: /var/lib/lunanexa/exclusive-lease-agent.json
            - name: LUNANEXA_LEASE_HELPER
              value: /usr/local/bin/lunanexa-lease-helper-client
            - name: LUNANEXA_LEASE_HELPER_HOST_ROOT
              value: /host
          volumeMounts:
            - name: host-root
              mountPath: /host
            - name: state
              mountPath: /var/lib/lunanexa
            - name: credentials
              mountPath: /etc/lunanexa/credentials
              readOnly: true
            - name: admin-settings
              mountPath: /etc/lunanexa/admin-policy
              readOnly: true
        - name: control-loopback-proxy
          image: ${NODE_IMAGE}
          imagePullPolicy: IfNotPresent
          command: [/usr/local/bin/lunanexa-loopback-proxy]
          args: ["127.0.0.1", "18080", "lunanexa-control.${NAMESPACE}.svc.cluster.local", "8080"]
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 65532
            runAsGroup: 65532
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 250m
              memory: 64Mi
      volumes:
        - name: host-root
          hostPath:
            path: /
            type: Directory
        - name: state
          hostPath:
            path: /var/lib/lunanexa/node-agent
            type: DirectoryOrCreate
        - name: credentials
          secret:
            defaultMode: 256
            secretName: ${SECRET_NAME}
        - name: admin-settings
          configMap:
            defaultMode: 420
            name: lunanexa-admin-settings
