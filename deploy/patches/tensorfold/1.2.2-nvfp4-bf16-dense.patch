 const Tensor = core.checkpoint.Tensor;
 const prefix = "model.language_model.";
+
+fn denseStoredFormat(dtype: core.checkpoint.DType) formats.Format {
+    return switch (dtype) {
+        .bf16 => .bf16,
+        .f8_e4m3 => .mxfp8,
+        else => .nvfp4,
+    };
+}
+
+test "GLM NVFP4 checkpoint may retain dense projections in BF16" {
+    try std.testing.expectEqual(formats.Format.bf16, denseStoredFormat(.bf16));
+    try std.testing.expectEqual(formats.Format.nvfp4, denseStoredFormat(.u8));
+    try std.testing.expectEqual(formats.Format.mxfp8, denseStoredFormat(.f8_e4m3));
+}
+
