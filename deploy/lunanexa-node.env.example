# Copy to /etc/lunanexa/node.env with mode 0640 and root:lunanexa ownership.
# Secrets remain in the referenced root-managed files, never in this file.
LUNANEXA_ENDPOINT=https://management.example.invalid
LUNANEXA_NODE_ID=dgx-spark-01
LUNANEXA_NODE_INVENTORY_PATH=/etc/lunanexa/inventory.json
LUNANEXA_NODE_STATE_PATH=/var/lib/lunanexa/node-state.json
LUNANEXA_NODE_CERTIFICATE_PATH=/var/lib/lunanexa/node-certificate.json
LUNANEXA_LEASE_STATE_PATH=/var/lib/lunanexa/exclusive-lease-agent.json
LUNANEXA_LEASE_HELPER=/usr/libexec/lunanexa-lease-helper-client
LUNANEXA_MODEL_CACHE_PATH=/var/lib/lunanexa/models
LUNANEXA_ARTIFACT_ENDPOINT=https://management.example.invalid/v1/artifacts
LUNANEXA_ARTIFACT_MAX_SIZE_BYTES=1099511627776
LUNANEXA_COSIGN_BINARY=/usr/bin/cosign
LUNANEXA_COSIGN_PUBLIC_KEY_PATH=/etc/lunanexa/cosign.pub
LUNANEXA_NODE_PUBLIC_KEY_REF=host-ref:/etc/lunanexa/node-public-key
LUNANEXA_CONTAINER_ENGINE=/usr/bin/podman
LUNANEXA_RUNTIME_NETWORK=lunanexa-runtime
LUNANEXA_CONTAINER_ENGINE_ENDPOINT=unix:///run/podman/podman.sock
LUNANEXA_NODE_TOKEN_PATH=/etc/lunanexa/node-token
LUNANEXA_ARTIFACT_CREDENTIAL_PATH=/etc/lunanexa/artifact-credential
LUNANEXA_ASSIGNMENT_SIGNING_SECRET_PATH=/etc/lunanexa/assignment-verification-key
LUNANEXA_BOOTSTRAP_TOKEN_ID_PATH=/etc/lunanexa/bootstrap-token-id
LUNANEXA_BOOTSTRAP_TOKEN_PATH=/etc/lunanexa/bootstrap-token
LUNANEXA_NVIDIA_SMI_BINARY=/usr/bin/nvidia-smi
