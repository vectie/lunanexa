# Host-systemd layout only. This file configures a node agent that runs on the
# compute host itself and drives a container engine over a socket there. The
# deployed cluster layout runs the agent as a Kubernetes Deployment with
# LUNANEXA_RUNTIME_BACKEND=kubernetes and needs no container engine on the host
# at all; see deploy/cluster/README.md. The OCI variables below are dead for
# that layout.
# Copy to /etc/lunanexa/node.env with mode 0640 and root:lunanexa ownership.
# Secrets remain in the referenced root-managed files, never in this file.
LUNANEXA_ENDPOINT=https://management.example.invalid
LUNANEXA_NODE_ID=dgx-spark-01
LUNANEXA_ADMIN_SETTINGS_PATH=/etc/lunanexa/admin-settings.json
LUNANEXA_NODE_INVENTORY_PATH=/etc/lunanexa/inventory.json
LUNANEXA_NODE_STATE_PATH=/var/lib/lunanexa/node-state.json
LUNANEXA_NODE_CERTIFICATE_PATH=/var/lib/lunanexa/node-certificate.json
LUNANEXA_LEASE_STATE_PATH=/var/lib/lunanexa/exclusive-lease-agent.json
LUNANEXA_LEASE_HELPER=/usr/libexec/lunanexa-lease-helper-client
LUNANEXA_EXCLUSIVE_LEASES_ENABLED=1
LUNANEXA_MODEL_CACHE_PATH=/var/lib/lunanexa/models
LUNANEXA_ARTIFACT_TRANSPORT=s3-sigv4
# This must be the Moongate-routed S3-compatible endpoint, without a path.
LUNANEXA_ARTIFACT_ENDPOINT=https://models.moongate.example.invalid
LUNANEXA_S3_REGION=cn-east-1
LUNANEXA_S3_ACCESS_KEY_ID_PATH=/etc/lunanexa/s3-access-key-id
LUNANEXA_S3_SECRET_ACCESS_KEY_PATH=/etc/lunanexa/s3-secret-access-key
# Optional short-lived STS token. Omit the file when static scoped credentials
# are used.
LUNANEXA_S3_SESSION_TOKEN_PATH=/etc/lunanexa/s3-session-token
LUNANEXA_ARTIFACT_MAX_SIZE_BYTES=1099511627776
LUNANEXA_COSIGN_BINARY=/usr/bin/cosign
LUNANEXA_COSIGN_PUBLIC_KEY_PATH=/etc/lunanexa/cosign.pub
# For read-only/offline bundle verification, mount administrator-validated
# Sigstore trusted material and enable this reference. Keep it updated through
# the deployment trust process; never replace verification with bypass flags.
# LUNANEXA_COSIGN_TRUSTED_ROOT_PATH=/etc/lunanexa/cosign-trusted-root.json
LUNANEXA_NODE_PUBLIC_KEY_REF=host-ref:/etc/lunanexa/node-public-key
# Host-systemd deployments may keep OCI. Cluster deployments use the
# Kubernetes backend shown in deploy/node-daemonset.yaml instead.
LUNANEXA_RUNTIME_BACKEND=oci
LUNANEXA_CONTAINER_ENGINE=/usr/bin/podman
LUNANEXA_RUNTIME_NETWORK=lunanexa-runtime
LUNANEXA_CONTAINER_ENGINE_ENDPOINT=unix:///run/podman/podman.sock
LUNANEXA_NODE_TOKEN_PATH=/etc/lunanexa/node-token
LUNANEXA_ASSIGNMENT_SIGNING_SECRET_PATH=/etc/lunanexa/assignment-verification-key
LUNANEXA_BOOTSTRAP_TOKEN_ID_PATH=/etc/lunanexa/bootstrap-token-id
LUNANEXA_BOOTSTRAP_TOKEN_PATH=/etc/lunanexa/bootstrap-token
LUNANEXA_NVIDIA_SMI_BINARY=/usr/bin/nvidia-smi
