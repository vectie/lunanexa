[Unit]
Description=LunaNexa lab controller loopback tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lunanexa
Group=lunanexa
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/lunanexa/tunnel-known-hosts -i /etc/lunanexa/tunnel-identity -L 127.0.0.1:18443:127.0.0.1:4174 OPERATOR_SSH_USER@MANAGEMENT_LAN_IP
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
