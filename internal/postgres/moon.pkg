import {
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/env",
} for "test"

supported_targets = "native"

options(
  "native-stub": [ "libpq.c", "pool.c" ],
  targets: { "postgres.mbt": [ "native" ], "pool.mbt": [ "native" ], "postgres_test.mbt": [ "native" ], "pool_test.mbt": [ "native" ] },
  link: {
    "native": {
      "cc-link-flags": "-L/opt/homebrew/lib/postgresql@17 -lpq -pthread -ldl",
      "stub-cc-flags": "-O2 -I/usr/include/postgresql -I/opt/homebrew/include/postgresql@17",
    },
  },
)
