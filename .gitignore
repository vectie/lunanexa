/_build/
/scripts/_build/
/.mooncakes/
/.repos/
/submissions/
/.moonserve-staging/
/.DS_Store
*.log
*.pid
*.local
*.secret
.env
.env.*
!.env.example

# Runtime state never belongs in source control.
/state/
/artifacts/
/output/pdf/
/output/credentials/
/_artifacts/
/benchmarks/results/
/deploy/local/
# Site-rendered launch/ingress overlays stay local; commit templates instead.
/deploy/cluster/*-patch.json
/deploy/cluster/*-public.yaml
/deploy/offline-transfer/public-upload.yaml
/lunanexa-*.json
/lunanexa-*.json.*

# Licensed contract fonts are deployment inputs, never repository content.
/assets/fonts/private/*
!/assets/fonts/private/README.md

# Reproducible OFL fonts are downloaded at build/deploy time, not stored in Git.
/assets/fonts/open/**/*.ttf
/assets/fonts/open/**/*.otf

# One-click cluster deployment reads its sudo passwords from here; never commit them.
deploy/cluster/credentials.json
